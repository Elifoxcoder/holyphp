{
  "PHP function": {
    "prefix": "fun",
    "body": [
      "function ${1:name}(${2:int \\$n}): ${3|int,string,bool,float,void,array|} {",
      "\t$0",
      "}"
    ],
    "description": "Function with typed params and return type"
  },
  "If statement": {
    "prefix": "if",
    "body": ["if (${1:\\$cond}) {", "\t$0", "}"],
    "description": "if block"
  },
  "If / else": {
    "prefix": "ife",
    "body": ["if (${1:\\$cond}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else block"
  },
  "Foreach loop": {
    "prefix": "fore",
    "body": ["foreach (\\$${1:items} as \\$${2:item}) {", "\t$0", "}"],
    "description": "foreach over an array"
  },
  "Foreach key => value": {
    "prefix": "forek",
    "body": ["foreach (\\$${1:map} as \\$${2:k} => \\$${3:v}) {", "\t$0", "}"],
    "description": "foreach with key and value"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while (${1:\\$i < 10}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for (\\$${1:i} = 0; \\$${1:i} < ${2:n}; \\$${1:i}++) {", "\t$0", "}"],
    "description": "classic for loop"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:\\$x}) {",
      "    case ${2:1}:",
      "        $3",
      "        break;",
      "    default:",
      "        $0",
      "        break;",
      "}"
    ],
    "description": "switch / case"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    public ${2:int} \\$${3:value};",
      "",
      "    public function __construct(${2:int} \\$${3:value}) {",
      "        \\$this->${3:value} = \\$${3:value};",
      "    }",
      "}"
    ],
    "description": "class with constructor"
  },
  "Try / catch": {
    "prefix": "try",
    "body": ["try {", "\t$1", "} catch (Exception \\$e) {", "\techo \"Error: {\\$e}\";", "}"],
    "description": "try / catch block"
  },
  "Echo": {
    "prefix": "echo",
    "body": ["echo \"${1:text}\";"],
    "description": "echo statement"
  },
  "Array append": {
    "prefix": "push",
    "body": ["\\$${1:arr}[] = ${2:value};"],
    "description": "append to array"
  },
  "Simple for loop": {
    "prefix": "fori",
    "body": ["for (\\$i = 0; \\$i < ${1:10}; \\$i++) {", "\t$0", "}"],
    "description": "counted for loop with $i from 0"
  },
  "Reverse for loop": {
    "prefix": "forr",
    "body": ["for (\\$i = ${1:n} - 1; \\$i >= 0; \\$i--) {", "\t$0", "}"],
    "description": "counted for loop downwards"
  },
  "For loop over range": {
    "prefix": "forr2",
    "body": ["for (\\$${1:i} = ${2:0}; \\$${1:i} < ${3:10}; \\$${1:i}++) {", "\t$0", "}"],
    "description": "for loop with a named counter"
  },
  "Match expression": {
    "prefix": "matchx",
    "body": [
      "\\$${1:result} = match (\\$${2:value}) {",
      "    ${3:0} => \"${4:zero}\",",
      "    _ => \"${5:other}\",",
      "};",
      "$0"
    ],
    "description": "match expression assigned to a variable"
  },
  "Print line": {
    "prefix": "println",
    "body": ["println(\"${1:text}\");"],
    "description": "println with newline"
  },
  "Print line in colour": {
    "prefix": "printc",
    "body": ["println(\"${1:text}\", ${2:GREEN});"],
    "description": "println with an ANSI colour constant"
  },
  "Read input": {
    "prefix": "input",
    "body": ["\\$${1:name} = input(\"${2:> }\");", "$0"],
    "description": "prompt and read one line from stdin"
  },
  "Import library": {
    "prefix": "import",
    "body": ["import \"${1:ui}\";"],
    "description": "import a library (ui, async, thread, …)"
  }
}
