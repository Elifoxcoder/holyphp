# .hpx is a packed archive with byte-length-prefixed entries ("<name> <len>\n").
# Git's CRLF conversion changes byte counts and shifts every payload offset,
# so a converted .hpx no longer parses. Treat archives as binary.
*.hpx binary

# Scripts that must keep LF line endings (bash/CI).
*.sh text eol=lf
# Linux desktop files: appimagetool rejects CRLF line endings
*.desktop text eol=lf
AppRun text eol=lf
# server-side scripts run through a shebang: CRLF breaks "#!/usr/bin/env python3"
*.py text eol=lf

# Vendored sources are verified by hash in their README, so Git must not
# rewrite their line endings.
third_party/sqlite/* -text