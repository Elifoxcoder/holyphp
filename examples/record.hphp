// record.hphp — record-setting int/float loops, compiled to native C.
//
//   hphp build examples/record.hphp -o record.exe && ./record.exe
//
// Loop 1 is pure int (the classic "int loop" benchmark).
// Loop 2 mixes ints and floats with % * / — the case where boxed
// interpreters (Python, PHP, Ruby) pay a type-tag tax every iteration.
// The compiled HolyPHP versions are plain native C: same instructions
// a hand-written C program gets from the same gcc -O2.

$t0 = hrtime(true);
$sum = 0;
for ($i = 0; $i < 100000000; $i++) {
    $sum += $i % 7;
}
$t1 = hrtime(true);

$t2 = hrtime(true);
$t = 0.0;
for ($i = 1; $i <= 100000000; $i++) {
    $t += $i * 3 % 5 - $i / 2;
}
$t3 = hrtime(true);

echo "int_loop_100M_ns   = " . ($t1 - $t0) . "  (sum={$sum})\n";
echo "mixed_loop_100M_ns = " . ($t3 - $t2) . "  (t={$t})\n";
