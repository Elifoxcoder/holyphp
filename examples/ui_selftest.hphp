// ui_selftest.hphp — headless smoke test for the HolyPHP UI 2.0 library.
//
//   hphp run examples/ui_selftest.hphp
//
// Creates a window, exercises every factory, both layout directions, the
// theme system and the role system, ticks the event pump and closes. No
// interaction required: it verifies handles, layout maths and dispatch.
import "ui";

$fails = [];
function ck(bool $ok, string $what) {
    global $fails;
    if (!$ok) { $fails[] = $what; echo "  FAIL {$what}\n"; }
    else { echo "  ok   {$what}\n"; }
}

$app = new App("selftest", 520, 640);
echo "window handle: {$app->h}\n";
ck($app->h > 0, "window created");
ck($app->alive(), "window alive");

// ---- every widget type ------------------------------------------------
$app->heading("Self test");
$app->sub("layout, themes and roles");
$lbl  = $app->label("plain label");
$in   = $app->input("type here");
$cb   = $app->checkbox("check me", true);
$lst  = $app->list(["alpha", "beta", "gamma"]);
$cmb  = $app->combo(["one", "two", "three"]);
$bar  = $app->progress(0);
$sld  = $app->slider(50);
$div  = $app->divider();
$btn  = $app->button("Press me", "primary");

ck($lbl->h > 0 && $in->h > 0 && $cb->h > 0, "label/input/checkbox created");
ck($lst->h > 0 && $cmb->h > 0, "list and combo created");
ck($bar->h > 0 && $sld->h > 0 && $div->h > 0, "progress, slider, divider");
ck($btn->h > 0, "button created");

// ---- values -----------------------------------------------------------
$in->setValue("changed");
ck($in->content() == "changed", "input round-trips a value");
ck($lbl->text("updated")->content() == "updated", "label round-trips a value");
ck($cb->checked(), "checkbox starts checked");
$cb->setChecked(false);
ck(!$cb->checked(), "checkbox unchecks");
ck($lst->count() == 3, "list has 3 items");
$lst->select(1);
ck($lst->selected() == 1, "list selection");
ck($lst->selectedText() == "beta", "list selected text");
$cmb->select(2);
ck($cmb->selectedText() == "three", "combo selected text");
$bar->progress(42);
ck($bar->percent() == 42, "progress round-trips");
$sld->value(70);
ck($sld->current() == 70, "slider round-trips");
$sld->range(0, 10);
ck($sld->current() <= 10, "slider range clamps");

// ---- enable / disable -------------------------------------------------
$btn->disable();
ck($btn->disabled(), "disable works");
$btn->enable();
ck($btn->enabled(), "enable works");
$btn->hide();
$btn->show();

// ---- layout -----------------------------------------------------------
// A vertical flow must consume height; a row must not run into the next
// widget. Both are checked through the Flow class directly so the test
// stays headless and deterministic.
$f = new Flow("v", 0, 0, 200, 10);
$a = $f->take(100, 30, false);
$b = $f->take(100, 30, false);
ck($a[0] == 0 && $a[1] == 0, "flow: first widget at origin");
ck($b[1] == 40, "flow: vertical gap is 10");
ck($f->measure() == 70, "flow: measured height");

$r = new Flow("h", 0, 0, 120, 10);
$r->take(100, 30, false);
$r->take(100, 30, false);
ck($r->measure() == 70, "flow: row wraps and stacks");

$c = new Flow("v", 0, 0, 200, 10);
$c->take(100, 30, false);
$c->grow(40, 70);
ck($c->measure() == 70, "flow: grow moves the cursor by the delta");
$c->grow(0, 70);
ck($c->measure() == 70, "flow: an unchanged child adds nothing");
/* The gap belongs to take(), which already counted it when the child was
 * placed. Charging it again on every growth event used to reserve a phantom
 * gap per *descendant* of a nested container. */
$cg = new Flow("v", 0, 0, 200, 10);
$cg->take(200, 1, true);
$cg->grow(30, 31); $cg->grow(30, 61); $cg->grow(30, 91);
ck($cg->measure() == 91, "flow: three growths do not add three gaps");

/* Children of a row share one line, so the line is as tall as the tallest of
 * them -- adding the deltas instead stacked three columns into one huge one. */
$rw = new Flow("h", 0, 0, 900, 10);
$rw->take(270, 1, true);
$rw->grow(399, 400);
$rw->grow(199, 200);
$rw->grow(129, 130);
ck($rw->measure() == 400, "flow: a row is as tall as its tallest child");

// ---- containers -------------------------------------------------------
$col = $app->column(300);
ck($col->label("in a column")->h > 0, "column places widgets");
$row = $app->row(300);
ck($row->button("L")->h > 0 && $row->button("R")->h > 0, "row places widgets");
$card = $app->card(300);
ck($card->sub("in a card")->h > 0, "card places widgets");
$sec = $app->section("A section", 300);
ck($sec->checkbox("in a section")->h > 0, "section places widgets");

// ---- themes -----------------------------------------------------------
$names = ui_theme_names();
ck(count($names) == 7, "seven built-in themes");
$app->theme("light");
ck($app->_theme("dark") == 0, "light theme is not dark");
$app->theme("midnight");
ck($app->_theme("accent") == 0x7C5CFF, "midnight accent applied");
$app->theme("dark", ["accent" => 0xFF5722]);
ck($app->_theme("accent") == 0xFF5722, "theme override wins");
$app->radius(16);
ck($app->_theme("radius") == 16, "universal radius");
$app->font(12);
ck($app->fontPt == 12, "universal font size");
$app->theme("ocean");

// ---- roles ------------------------------------------------------------
ck(ui_role_id("primary") == 1, "role: primary");
ck(ui_role_id("subtle") == 2, "role: subtle");
ck(ui_role_id("ghost") == 3, "role: ghost");
ck(ui_role_id("danger") == 4, "role: danger");
ck(ui_role_id("success") == 5, "role: success");
ck(ui_role_id("link") == 6, "role: link");
ck(ui_role_id("nonsense") == 0, "role: unknown falls back");

// ---- colours ----------------------------------------------------------
ck(ui_rgb(0x4C, 0x7D, 0xFF) == 0x4C7DFF, "ui_rgb packs channels");
ck(ui_channel(0x4C7DFF, 0) == 0x4C, "ui_channel red");
ck(ui_channel(0x4C7DFF, 1) == 0x7D, "ui_channel green");
ck(ui_channel(0x4C7DFF, 2) == 0xFF, "ui_channel blue");
ck(ui_textw("hello", 10) > 0, "ui_textw measures a width");

// ---- text measurement -------------------------------------------------
// These are the assertions that catch the "headings overlap each other and
// the button padding is ragged" class of bug: text used to be estimated as
// strlen * pt * 0.62, which is far too narrow for anything but lowercase.
ck(ui_textw("W", 12) > ui_textw("i", 12) * 2, "W measures wider than i");
ck(ui_textw("WWWW", 12) > ui_textw("iiii", 12), "wide words measure wider");
ck(ui_textw("hello", 12, true) > ui_textw("hello", 12), "bold measures wider");
ck(ui_textw("", 12) == 0, "empty string measures zero");

// ---- layout ------------------------------------------------------------
// Build the same three-column shape the gallery uses and check the geometry
// the engine actually handed out.
$cols = $app->row();
$c1 = $cols->column(190);
$c2 = $cols->column(190);
$hd = $c1->heading("A heading");
$sb = $c1->sub("a quiet subtitle");
$bt1 = $c1->button("Subtle");
$bt2 = $c1->button("Primary", "primary");
$bt3 = $c1->button("Ghost", "ghost");
$other = $c2->label("right column");
$app->tick(20);

function overlaps(int $a, int $b): bool {
    $ra = ui_rect($a); $rb = ui_rect($b);
    if ($ra == null || $rb == null) { return false; }
    return ($ra[0] < $rb[0] + $rb[2]) && ($rb[0] < $ra[0] + $ra[2]) &&
           ($ra[1] < $rb[1] + $rb[3]) && ($rb[1] < $ra[1] + $ra[3]);
}
function rw(int $h, int $i): int { $r = ui_rect($h); return $r[$i]; }

ck(rw($hd->h, 2) > ui_textw("A heading", 12, true) + 20,
   "heading is as wide as its measured text");
ck(!overlaps($hd->h, $sb->h), "heading does not overlap the sub");
ck(!overlaps($sb->h, $bt1->h), "sub does not overlap the buttons");
ck(!overlaps($bt1->h, $bt2->h) && !overlaps($bt2->h, $bt3->h),
   "buttons in a column do not overlap");
ck(rw($bt1->h, 0) == rw($bt2->h, 0) && rw($bt2->h, 0) == rw($bt3->h, 0),
   "buttons in a column share a left edge");
ck(rw($bt1->h, 3) == rw($bt2->h, 3) && rw($bt2->h, 3) == rw($bt3->h, 3),
   "buttons in a column share a height");
ck(rw($other->h, 0) > rw($bt1->h, 0) + rw($bt1->h, 2) - 4,
   "the second column sits beside the first");
/* A container only tells its parent how tall it is when something is added to
 * *it*. Without walking the chain back up, a row of columns stays one pixel
 * tall in the app's flow and whatever comes next is drawn on top of it. */
$after = $app->label("after the columns");
$app->tick(20);
$bottom = rw($bt3->h, 1) + rw($bt3->h, 3);
ck(rw($after->h, 1) >= $bottom,
   "a widget added after a row clears the whole row");
ck(rw($after->h, 1) - $bottom < 200,
   "and does not clear far more than the row needs");

// A row is the other direction: same baseline, widths tracking the label.
$rrow = $app->row();
$r1 = $rrow->button("i");
$r2 = $rrow->button("WWWWWWWWWW");
$app->tick(20);
ck(rw($r1->h, 1) == rw($r2->h, 1), "buttons in a row share a baseline");
ck(rw($r2->h, 2) > rw($r1->h, 2) * 2,
   "a wide label gets a wider button, not the same padding");
/* Text widgets fill a column so a later ->font() cannot clip them into
 * "Butt..."; buttons must not, or a two-letter label gets a full-width box. */
$cl = $c1->label("a label in a column");
$app->tick(20);
ck(rw($cl->h, 2) >= rw($bt1->h, 2) * 2, "a label in a column spans it");
ck(rw($bt1->h, 2) < rw($cl->h, 2), "a button in a column still hugs its label");

// ---- scrolling ---------------------------------------------------------
$deep = $app->label("far below the fold");
$app->tick(20);
$sc = $app->scroll();
ck($sc[1] > $sc[2], "content is taller than the viewport");
$y0 = rw($deep->h, 1);
$app->scrollBy(120);
ck($app->scrollOffset() > 0, "scrollBy moves the offset");
ck(rw($deep->h, 1) == $y0 - 120, "scrolling moves the child by the same amount");
$app->scrollTo(0);
ck($app->scrollOffset() == 0, "scrollTo(0) returns to the top");
$app->scrollTo(100000);
ck($app->scrollOffset() == $sc[1] - $sc[2],
   "scrolling past the end clamps to the bottom");
$app->scrollTo(0);

// ---- event pump -------------------------------------------------------
$clicks = 0;
$btn->onClick = function() use (&$clicks) { $clicks = $clicks + 1; };
$app->tick(30);
$app->tick(30);
ck($app->alive(), "still alive after ticks");

// ---- menus ------------------------------------------------------------
$m = $app->menu("File");
$it = $m->item("Quit", function() { });
ck($it->h > 0, "menu item created");

// ---- geometry ---------------------------------------------------------
$abs = $app->button("abs", "ghost")->move(20, 20, 90, 0);
ck($abs->h > 0, "absolute placement works");

$app->close();
ck(!$app->alive(), "window closed");

if (count($fails) == 0) {
    echo "UI SELFTEST OK\n";
} else {
    echo "UI SELFTEST FAILED: " . implode(", ", $fails) . "\n";
    exit(1);
}
