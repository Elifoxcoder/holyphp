// ui_demo.hphp — the HolyPHP UI 2.0 showcase.
//
//   hphp run   examples/ui_demo.hphp     (keeps the console alive)
//   hphp build examples/ui_demo.hphp -o ui_demo.exe   (normal desktop app)
//
// Everything below is ordinary library usage: no pixel maths unless we
// really want it, one theme for the whole window, and widgets that place
// themselves.

import "ui";

$app = new App("HolyPHP UI 2.0", 880, 780);

// One call sets the whole look: colours, corner radius, type size, spacing.
$app->theme("midnight")->pad(28)->gap(12)->radius(12)->font(11);

$names = ui_theme_names();

// ------------------------------------------------------------------ menus

$file = $app->menu("File");
$file->item("New", function() use ($app) { $app->msg("New window coming."); });
$file->separator();
$file->item("Open…", function() use ($app) {
    $p = $app->openFile("Text|*.txt;HolyPHP|*.hphp");
    if ($p != "") { $app->msg("Opened:\n{$p}"); }
});
$file->separator();
$file->item("Quit", function() use ($app) { $app->close(); });

// ----------------------------------------------------------------- header

$app->heading("HolyPHP UI 2.0");
$app->sub("One theme for everything. Zero pixel maths.");

// A row of buttons shows off the six roles.
$roles = $app->row();
$roles->button("Subtle")->style("subtle");
$roles->button("Primary", "primary");
$roles->button("Ghost", "ghost");
$roles->button("Danger", "danger");
$roles->button("Success", "success");
$roles->link("or a link", function() use ($app) { $app->msg("Links work too."); });

$app->divider();

// -------------------------------------------------------------- left side

$cols = $app->row();
$left = $cols->column(400);

$form = $left->card(400);
$form->label("Sign in")->font(13, true);
$form->label("Email");
$email = $form->input("you@example.com");
$form->label("Password");
$pass = $form->input("........");
$form->checkbox("Remember me", true);
$actions = $form->row(370);
$actions->button("Cancel", "ghost")->disable();
$actions->button("Sign in", "primary", function() use ($app, $email) {
    $app->msg("Welcome, {$email->content()}!");
});
$form->link("Forgot your password?");

$prefs = $left->section("Preferences", 400);
$prefs->label("Font size");
$size = $prefs->slider(11);
$size->range(9, 16);
$prefs->label("Volume");
$vol = $prefs->slider(60);
$vol->range(0, 100);

// ------------------------------------------------------------- right side

$right = $cols->column(400);

$themes = $right->section("Theme", 400);
$picker = $themes->combo($names);
$themes->sub("Pick one — every control follows it instantly.");
$swatches = $themes->row(370);
foreach ($names as $n) {
    $swatches->button($n, "ghost", function() use ($app, $n) {
        $app->theme($n);
    });
}

$files = $right->card(400);
$files->label("Recent files")->font(13, true);
$list = $files->list(["notes.txt", "main.hphp", "readme.md", "logo.png"]);
$list->select(1);
$files->sub("Selected: {$list->selectedText()}");

$status = $right->card(400);
$status->label("Build status")->font(13, true);
$bar = $status->progress(0);
$statusLabel = $status->sub("Idle");

// ----------------------------------------------------------------- timers

$ticks = 0;
$app->every(400, function() use (&$ticks, $bar, $statusLabel) {
    $ticks = $ticks + 1;
    $pct = ($ticks * 5) % 100;
    $bar->progress($pct);
    $statusLabel->text("{$pct}% complete");
});

$app->run();
