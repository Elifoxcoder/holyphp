import "thread";
$pool = new Pool(4);
$r = $pool->map(function($x, $i) { return $x * $x + $i; }, [1,2,3,4,5,6,7,8]);
echo "map: ";
foreach ($r as $v) { echo $v . " "; }
echo "
";
$ch = new Channel(0);
thr_spawn(function() use ($ch) { thr_sleep_ms(50); $ch->send("via-class"); });
echo "recv: " . $ch->recv() . "
";
$at = new Atomic(10);
echo "atomic: " . $at->add(5) . "->" . $at->get() . "
";
echo "chunked: ";
foreach (thr_map_chunked([1,2,3,4,5,6,7,8,9], function($chunk) { $s = 0; foreach ($chunk as $x) { $s += $x; } return [$s]; }) as $v) { echo $v . " "; }
echo "
LIB THREAD OK
";
