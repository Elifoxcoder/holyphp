<?php
/* Hello, window
 *
 * The smallest complete desktop app. `new App()` opens a themed window,
 * and widgets such as `heading()`, `sub()` and `button()` stack themselves
 * top to bottom - no coordinates needed. A button takes a role (`primary`,
 * `danger`, `ghost`, ...) and a closure to run when it is clicked.
 *
 * try: hphp run 01-hello-window.hphp
 */

import "ui";

// A 480 x 300 window with the default dark theme.
$app = new App("Hello", 480, 300);

// Text: a big heading and a muted subtitle.
$app->heading("Hello, world");
$app->sub("This window was written in HolyPHP.");

// A button that opens a message box when clicked.
$app->button("Say hello", "primary", function() use ($app) {
    $app->msg("Hello from HolyPHP!", "Greetings");
});

// A second button that asks before closing the window.
$app->button("Quit", "ghost", function() use ($app) {
    if ($app->ask("Really quit?")) {
        $app->close();
    }
});

// Hand control to the window until it is closed.
$app->run();
