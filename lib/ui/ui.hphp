// =====================================================================
//  HolyPHP UI 2.0 — a small, beautiful desktop toolkit for HolyPHP
// =====================================================================
//
//  The whole library in one import:
//
//      import "ui";
//
//      $app = new App("Hello");
//      $app->heading("Hello, world");
//      $app->sub("This is HolyPHP UI 2.0.");
//      $app->button("Click me", "primary", function() {
//          $app->msg("It works.");
//      });
//      $app->run();
//
//  No pixel coordinates unless you ask for them: widgets stack themselves
//  in a column or flow left to right in a row, and every one of them
//  inherits a single theme — colours, corner radius, type size, all of it.
//
//  ---------------------------------------------------------------------
//  1. THE WINDOW
//  ---------------------------------------------------------------------
//      new App($title, $width, $height)
//      $app->run()                     start the event loop and block
//      $app->tick()                    pump events ~15 ms (for `hphp run`)
//      $app->close()  $app->quit()
//      $app->title("New")  $app->size(800, 600)  $app->pos(40, 60)
//
//  ---------------------------------------------------------------------
//  2. THEMES — one line restyles the whole app
//  ---------------------------------------------------------------------
//      $app->theme("dark");      // dark (default), light, midnight,
//                                 // ocean, forest, rose, mono
//      $app->theme("dark", ["accent" => 0xFF5722]);   // override one key
//      $app->theme(["bg" => 0x101014, "accent" => 0x7C5CFF, "dark" => 1]);
//
//  Keys: bg, surface, elevated, text, muted, accent, onAccent, border,
//        radius, font, title, row, dark.
//
//  A theme is a *universal style*. Every control follows it, and you can
//  swap it at any time — later widgets pick it up immediately. Anything
//  you set on a single widget always wins over the theme.
//
//      $app->radius(12);            // universal corner radius
//      $app->font(11);              // universal body size, in points
//      $app->pad(28);  $app->gap(14);    // universal layout rhythm
//      $app->style("primary");      // universal button role (see below)
//
//  ---------------------------------------------------------------------
//  3. ROLES — six ready-made button styles
//  ---------------------------------------------------------------------
//      $app->style("primary");      // every button from here on is accent
//
//      $app->button("Save");            // subtle  (the default)
//      $app->button("Save", "primary"); // filled with the accent colour
//      $app->button("Save", "ghost");   // no fill until you hover
//      $app->button("Delete", "danger");
//      $app->button("Done", "success");
//      $app->link("Read the docs");     // a text link
//
//  Any widget takes a role, radius, colour and font too:
//
//      $btn->style("ghost")->radius(20)->accent(0xE040FB)->font(12, true);
//
//  ---------------------------------------------------------------------
//  4. LAYOUT — coordinates are optional
//  ---------------------------------------------------------------------
//  Leave out x/y and widgets place themselves. Four containers exist:
//
//      $form = $app->column(420);   // vertical box, 420 px wide
//      $form->label("Email");
//      $form->input("you@example.com");
//      $form->button("Sign in", "primary", function() { ... });
//
//      $bar = $app->row();          // flows left to right, wraps when full
//      $bar->button("Yes")->button("No")->button("Cancel");
//
//      $card = $app->card(420);     // rounded surface, auto height
//      $card->label("Inside a card");
//
//      $sec = $app->section("Details", 420);   // captioned outline
//      $sec->checkbox("Show hidden files");
//
//  The window stacks its children top to bottom. To put things SIDE BY SIDE,
//  put them inside a row() — a row lays its children out across and wraps:
//
//      $cols = $app->row();
//      $left  = $cols->column(400);
//      $right = $cols->column(400);
//      $left->heading("Left");
//      $right->heading("Right");
//
//  Containers nest freely, and each one grows to fit what you put in it:
//
//      $app->card(460)->row(420)->button("Yes")->button("No");
//
//  Absolute placement also works, and never disturbs the flow:
//
//      $app->button("Reset", "ghost")->move(20, 20, 90, 0);
//      $app->label("top right", 480, 24);
//
//  ---------------------------------------------------------------------
//  5. WIDGETS
//  ---------------------------------------------------------------------
//  Text
//      $app->heading("Big title")      $app->sub("quiet subtitle")
//      $app->label("plain text")       $app->divider()
//  Buttons
//      $app->button($text, $role = "", $onClick = null)
//      $app->button("Save", "primary", function() { ... });
//      $app->link($text, $onClick = null)
//  Input
//      $app->input("initial text")     $app->checkbox("Remember me", true)
//  Collections
//      $app->list(["a", "b", "c"])     $app->combo(["a", "b", "c"])
//  Meters
//      $app->progress(35)              $app->slider(50)
//  Menus
//      $m = $app->menu("File");
//      $m->item("Open", function() { ... });
//      $m->separator();
//      $m->item("Quit", function() { ... });
//
//  Every widget shares the same methods, and all of them chain:
//
//      ->text($t)    set the text       ->content()  read it back
//      ->setValue($t)  alias of text()
//      ->show()      ->hide()
//      ->enable()    ->disable()         ->enabled()   ->disabled()
//      ->move($x, $y, $w, $h)            ->size($w, $h) ->focus()
//      ->font($pt, $bold = false)        ->color($rgb) ->bg($rgb)
//      ->accent($rgb) ->radius($px)      ->style($role)  ->repaint()
//      ->onClick($fn) ->onChange($fn)    ->onKey($fn)
//
//  Widget-specific extras:
//      input     ->setValue($v) ->content()
//      checkbox  ->checked() ->setChecked($b) ->toggle()
//      list      ->add($s) ->addAll([...]) ->items() ->count() ->clear()
//                ->remove($i) ->selected() ->select($i) ->selectedText()
//      combo     the same as list
//      slider    ->value($v) ->current() ->range($lo, $hi)
//      progress  ->progress($pct) ->percent()
//
//  ---------------------------------------------------------------------
//  6. DIALOGS
//  ---------------------------------------------------------------------
//      $app->msg("Saved.");           $app->warn("Careful.");
//      $app->error("That failed.");    $app->ask("Quit?");   // bool
//      $app->openFile("Text|*.txt")    $app->saveFile("Text|*.txt")
//      $app->folder()                  $app->color()      // 0xRRGGBB|null
//      $app->clip("copied text")       $app->paste()
//
//  ---------------------------------------------------------------------
//  7. TIMERS
//  ---------------------------------------------------------------------
//      $app->every(1000, function() use (&$n) { $n += 1; });
//
//  ---------------------------------------------------------------------
//  8. COLOURS are plain 0xRRGGBB integers
//  ---------------------------------------------------------------------
//      $app->button("Paint", "", 20, 20)->bg(0x1E88E5)->color(0xFFFFFF);
//
//  Two run modes: $app->run() blocks like a normal desktop app (best with
//  `hphp build`); $app->tick() returns every ~15 ms so your script keeps
//  control and console output stays alive (best with `hphp run`).
// =====================================================================


// ---------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------

/** Pack 0-255 channels into a 0xRRGGBB integer. */
function ui_rgb(int $r, int $g, int $b): int {
    return ($r << 16) | ($g << 8) | $b;
}

/** Read one channel back out: ui_channel(0x4C7DFF, 1) is 0x7D. */
function ui_channel(int $rgb, int $i): int {
    if ($i == 0) { return ($rgb >> 16) & 255; }
    if ($i == 1) { return ($rgb >> 8) & 255; }
    return $rgb & 255;
}

/** Text width in pixels, measured in the font it will be drawn with. */
function ui_textw(string $s, int $pt, bool $bold = false): int {
    if ($s == "") { return 0; }
    /* measured in the real font, not estimated: an average-width guess left
     * "iiii" swimming in padding and clipped "WWWW" */
    return ui_text_px($s, $pt, $bold);
}

/** Read $k out of a theme map, falling back to $def. */
function ui_pick($o, string $k, int $def): int {
    if ($o != null && array_key_exists($k, $o)) { return $o[$k]; }
    return $def;
}

/** Overlay the known theme keys of $over onto $base. */
function ui_merge($base, $over) {
    $out = $base;
    $keys = ["bg", "surface", "elevated", "text", "muted", "accent", "onAccent",
             "border", "radius", "font", "title", "row", "dark"];
    foreach ($keys as $k) {
        if (array_key_exists($k, $over)) { $out[$k] = $over[$k]; }
    }
    return $out;
}

/** Role name -> the number the native layer uses. */
function ui_role_id(string $role): int {
    return match ($role) {
        "primary"            => 1,
        "subtle", "secondary" => 2,
        "ghost"              => 3,
        "danger"             => 4,
        "success"            => 5,
        "link"               => 6,
        _                    => 0,
    };
}

// ---------------------------------------------------------------------
// Built-in themes. Every one is a plain map, so you can copy a preset,
// change a key or two, and hand the whole thing to $app->theme().
// ---------------------------------------------------------------------

function ui_theme_dark() {
    return [
        "bg" => 0x0F1115, "surface" => 0x171A21, "elevated" => 0x1E222B,
        "text" => 0xE8EAF0, "muted" => 0x969FB0, "accent" => 0x4C7DFF,
        "onAccent" => 0xFFFFFF, "border" => 0x2B313D,
        "radius" => 8, "font" => 10, "title" => 17, "row" => 28, "dark" => 1,
    ];
}

function ui_theme_light() {
    return [
        "bg" => 0xF5F6F8, "surface" => 0xFFFFFF, "elevated" => 0xFFFFFF,
        "text" => 0x14161C, "muted" => 0x6B7280, "accent" => 0x2F6BFF,
        "onAccent" => 0xFFFFFF, "border" => 0xDFE3E9,
        "radius" => 8, "font" => 10, "title" => 17, "row" => 28, "dark" => 0,
    ];
}

