    return [
        "bg" => 0x05070D, "surface" => 0x0C101C, "elevated" => 0x141A2B,
        "text" => 0xDCE3F5, "muted" => 0x7B88A8, "accent" => 0x7C5CFF,
        "onAccent" => 0xFFFFFF, "border" => 0x1E2740,
        "radius" => 12, "font" => 10, "title" => 17, "row" => 30, "dark" => 1,
    ];
}

function ui_theme_ocean() {
    return [
        "bg" => 0x07202A, "surface" => 0x0C2E3C, "elevated" => 0x123B4D,
        "text" => 0xE4F4FA, "muted" => 0x84B4C4, "accent" => 0x22C3A6,
        "onAccent" => 0x04231E, "border" => 0x17475C,
        "radius" => 10, "font" => 10, "title" => 17, "row" => 28, "dark" => 1,
    ];
}

function ui_theme_forest() {
    return [
        "bg" => 0x0D1510, "surface" => 0x141F18, "elevated" => 0x1C2A20,
        "text" => 0xE7F2E9, "muted" => 0x8FA796, "accent" => 0x6FCF4F,
        "onAccent" => 0x0A1A08, "border" => 0x24382A,
        "radius" => 10, "font" => 10, "title" => 17, "row" => 28, "dark" => 1,
