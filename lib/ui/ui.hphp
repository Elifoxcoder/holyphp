}

function ui_theme_rose() {
    return [
        "bg" => 0x1A0F13, "surface" => 0x26171C, "elevated" => 0x332026,
        "text" => 0xF8E9EC, "muted" => 0xC0919C, "accent" => 0xF2607A,
        "onAccent" => 0x2B0A12, "border" => 0x41272F,
        "radius" => 14, "font" => 10, "title" => 17, "row" => 28, "dark" => 1,
