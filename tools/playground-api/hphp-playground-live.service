[Unit]
Description=HolyPHP playground live runner (pty + SSE, input() during a run)
After=network.target docker.service var-lib-hphp\x2dplayground-jobs.mount
Requires=docker.service var-lib-hphp\x2dplayground-jobs.mount

[Service]
Type=simple
Slice=hphp-playground.slice
User=hphpplay
Group=hphpplay
Environment=HOME=/tmp/hphp-home
ExecStart=/usr/bin/python3 /opt/hphp-playground/api/live.py
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/hphp-playground/jobs/live
Restart=always
RestartSec=2

# Same threat model as hphp-playground.service: visitors submit arbitrary
# programs. The only privileged command is the argument-validating container
# launcher; user programs run with all capabilities dropped inside Docker.
# PrivateDevices is deliberately absent — the runner needs /dev/ptmx so the
# submitted program gets a real terminal (that is what makes input() live).
NoNewPrivileges=no
# These are only in the bounding set for sudo-rs to enter the root launcher.
# Nothing is ambient; the container drops all capabilities and sets no-new-privileges.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
AmbientCapabilities=
PrivateTmp=no
TemporaryFileSystem=/tmp:rw,size=128M,nr_inodes=4096,mode=1777,nosuid,nodev
TemporaryFileSystem=/dev/shm:rw,size=32M,nr_inodes=1024,mode=1777,nosuid,nodev
UMask=0077
ProtectSystem=strict
ReadWritePaths=
ReadWritePaths=/run/hphp-playground /var/lib/hphp-playground/jobs
ProtectHome=yes
InaccessiblePaths=/var/www /root
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectProc=invisible

# loopback only: nginx talks to it, the submitted programs get no network
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryMax=512M
CPUQuota=75%
TasksMax=128
LimitNOFILE=512
LimitFSIZE=64M
LimitCORE=0

[Install]
WantedBy=multi-user.target
