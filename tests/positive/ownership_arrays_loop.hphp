<?php
/* ownership_arrays_loop.hphp — the array group's ownership loop. Mutating
 * builtins borrow the array and return scalars/booleans; the loop reuses one
 * array and must stay flat (tests/rss.ps1). */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$list = [];
for ($j = 0; $j < 64; $j++) { $list[] = $j; }
$needle = 2;
$acc = 0;
for ($i = 0; $i < 20000; $i++) {
    array_push($list, 4);
    array_unshift($list, 0);
    $acc += array_pop($list);
    $acc += array_shift($list);
    sort($list);
    $acc += end($list);
    $acc += reset($list);
    $acc += array_sum($list);
    $acc += array_product($list);
    $acc += in_array($needle, $list) ? 1 : 0;
    $acc += array_key_exists(0, $list) ? 1 : 0;
    $acc += array_search(2, $list);
    if (count($list) > 64) { arr_clear($list); }
}
unsafe { arr_free($list); }
check("array loop accumulated work", $acc > 0);
echo "ownership arrays loop ok\n";
