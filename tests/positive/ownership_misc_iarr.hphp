<?php
/* ownership_misc_iarr.hphp — a typed int array is a handle; the caller
 * releases it. Values are integers, so there is no element ownership. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$a = iarr_new(4);
check("iarr_new returns a handle", $a != 0);
check("a new typed array is empty", iarr_len($a) == 0);
iarr_set($a, 0, 11);
iarr_set($a, 1, 22);
check("iarr_set/iarr_get", iarr_get($a, 0) == 11 && iarr_get($a, 1) == 22);
check("iarr_get out of range is 0", iarr_get($a, 99) == 0);
unsafe { iarr_release($a); }

$b = iarr_new(2);
iarr_set($b, 0, 7);
unsafe {
    iarr_set_fast($b, 1, 9);
    check("iarr fast path", iarr_get_fast($b, 1) == 9);
    check("iarr_data_ptr points at the values", i64_at(iarr_data_ptr($b), 0) == 7);
    iarr_release($b);
}

unsafe { $u = iarr_new_uninit(3); }
iarr_set($u, 0, 1);
iarr_set($u, 2, 3);
check("uninitialised array after filling", iarr_get($u, 0) == 1 && iarr_get($u, 2) == 3);
unsafe { iarr_release($u); }

echo "ownership misc iarr ok\n";
