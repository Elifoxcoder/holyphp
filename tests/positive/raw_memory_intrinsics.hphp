<?php
// u8_at / u8_set / i64_at / i64_set on int operands compile to direct loads
// and stores; results must match the runtime builtins.
$addr = 0;
unsafe { $buf = iarr_new_uninit(4); $addr = iarr_data_ptr($buf); }
unsafe {
    i64_set($addr, 0, 0);
    i64_set($addr, 1, -5);
    $r = i64_set($addr, 2, 1234567890123);
    if ($r !== 1234567890123) { exit(1); }
    if (i64_at($addr, 1) !== -5) { exit(2); }
    if (i64_at($addr, 2) !== 1234567890123) { exit(3); }
    $v = u8_set($addr, 0, 511);
    if ($v !== 511) { exit(4); }
    if (u8_at($addr, 0) !== 255) { exit(5); }
    if (u8_at($addr, 1) !== 0) { exit(6); }
    if (u8_at(0, 3) !== 0 || i64_at(0, 3) !== 0) { exit(7); }   /* null address reads 0 */
    $k = 1;
    $s = 0;
    $s = i64_at($addr, $k) + u8_at($addr, $k - 1);
    if ($s !== 250) { exit(8); }
}
echo "ok\n";
