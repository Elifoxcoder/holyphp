<?php
/* ownership_strings_loop.hphp — the string group's ownership loop.
 *
 * Every builtin returns a value the caller owns. The loop runs 20000 times,
 * releases each result explicitly (this core has no reference counting yet)
 * and must not grow: tests/rss.ps1 checks that. All literals are hoisted
 * because a literal is a fresh heap object per evaluation in this core.
 */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    return false;
}

$unit = str_repeat("Abc def Ghi ", 512);
$needle = "Ghi";
$repl = "xyz";
$pad = ".";
$dot = ".";
$empty = "";
$nl = "\n";
$key = "key";
$fmt = "%s:%d";
$parts = ["a", "b", "c"];
$glue = "-";
$ent = "<a href='x'>&</a>";
$acc = 0;

for ($i = 0; $i < 20000; $i++) {
    $r = strtoupper($unit);      $acc += strlen($r); unsafe { str_free($r); }
    $r = strtolower($unit);      $acc += strlen($r); unsafe { str_free($r); }
    $r = ucfirst($unit);         $acc += strlen($r); unsafe { str_free($r); }
    $r = lcfirst($unit);         $acc += strlen($r); unsafe { str_free($r); }
    $r = trim($unit);            $acc += strlen($r); unsafe { str_free($r); }
    $r = ltrim($unit);           $acc += strlen($r); unsafe { str_free($r); }
    $r = rtrim($unit);           $acc += strlen($r); unsafe { str_free($r); }
    $r = strrev($unit);          $acc += strlen($r); unsafe { str_free($r); }
    $r = str_repeat($unit, 2);   $acc += strlen($r); unsafe { str_free($r); }
    $r = str_pad($unit, 12000, $pad); $acc += strlen($r); unsafe { str_free($r); }
    $r = str_replace($needle, $repl, $unit); $acc += strlen($r); unsafe { str_free($r); }
    $r = substr($unit, 3, 100);  $acc += strlen($r); unsafe { str_free($r); }
    $r = strstr($unit, $needle); $acc += strlen($r); unsafe { str_free($r); }
    $r = nl2br($nl);             $acc += strlen($r); unsafe { str_free($r); }
    $r = number_format(1234567.891, 2); $acc += strlen($r); unsafe { str_free($r); }
    $r = implode($glue, $parts); $acc += strlen($r); unsafe { str_free($r); }
    $r = join($glue, $parts);    $acc += strlen($r); unsafe { str_free($r); }
    $r = sprintf($fmt, $unit, $i); $acc += strlen($r); unsafe { str_free($r); }
    $r = base64_encode($unit);   $acc += strlen($r); unsafe { str_free($r); }
    $r = base64_decode($unit);   $acc += strlen($r); unsafe { str_free($r); }
    $r = urlencode($unit);       $acc += strlen($r); unsafe { str_free($r); }
    $r = urldecode($unit);       $acc += strlen($r); unsafe { str_free($r); }
    $r = htmlentities($ent);     $acc += strlen($r); unsafe { str_free($r); }
    $r = htmlspecialchars($ent); $acc += strlen($r); unsafe { str_free($r); }
    $r = strip_tags($ent);       $acc += strlen($r); unsafe { str_free($r); }
    $r = html_entity_decode($ent); $acc += strlen($r); unsafe { str_free($r); }
    $r = bin2hex($unit);         $acc += strlen($r); unsafe { str_free($r); }
    $r = ucwords($unit);         $acc += strlen($r); unsafe { str_free($r); }
    $r = wordwrap($unit, 40);    $acc += strlen($r); unsafe { str_free($r); }
    $r = str_shuffle($unit);     $acc += strlen($r); unsafe { str_free($r); }
    $r = md5($unit);             $acc += strlen($r); unsafe { str_free($r); }
    $r = sha1($unit);            $acc += strlen($r); unsafe { str_free($r); }
    $r = sha256($unit);          $acc += strlen($r); unsafe { str_free($r); }
    $r = hash_hmac("sha256", $unit, $key); $acc += strlen($r); unsafe { str_free($r); }
    $acc += crc32($unit);
    $acc += similar_text($unit, $unit);
    $acc += levenshtein($needle, $repl);
    $acc += strncasecmp($unit, $unit, 32);
}

if (!check("string loop accumulated work", $acc > 0)) { $fail = $fail + 1; }
if ($fail == 0) { echo "ownership strings loop ok\n"; }
else { exit(1); }
