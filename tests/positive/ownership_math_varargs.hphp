<?php
/* ownership_math_varargs.hphp — max()/min() accept several arguments or one
 * array; the result is a borrowed element/value, never a new allocation. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

check("max of three", max(1, 9, 4) == 9);
check("min of three", min(1, 9, 4) == 1);
check("max of two floats", max(1.5, 2.5) == 2.5);
check("min of two floats", min(1.5, 2.5) == 1.5);

$words = ["pear", "apple", "fig"];
check("max of strings", max($words) == "pear");
check("min of strings", min($words) == "apple");
check("the array survived", count($words) == 3 && $words[1] == "apple");

$one = [42];
check("max of one element", max($one) == 42);
check("min of one element", min($one) == 42);

echo "ownership math varargs ok\n";
