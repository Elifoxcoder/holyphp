// tests/positive/byref.hphp — PHP by-reference parameters (&$x).
function addone(int &$x): void { $x += 1 }
function bump(string &$s): void { $s .= "!" }
function swap(int &$a, int &$b): void {
    $t = $a; $a = $b; $b = $t;
}

$n = 5;
addone($n);
echo $n == 6 ? "addone OK" : "addone FAIL", "\n";

$w = "hi";
bump($w);
echo $w == "hi!" ? "bump OK" : "bump FAIL", "\n";

$a = 1; $b = 2;
swap($a, $b);
echo $a == 2 && $b == 1 ? "swap OK" : "swap FAIL", "\n";
