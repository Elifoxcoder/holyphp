<?php
// A variable first assigned in both arms of an if/else keeps working after
// the if. Same scalar type in both arms: a plain typed slot; different
// types: a dynamic value, as before.
function pick(int $c): int {
    if ($c > 0) { $lo = $c * 2; $hi = strlen("abc"); }
    else { $lo = 1; $hi = 7; }
    return $lo + $hi;
}
function mixed_arms(int $c): string {
    if ($c > 0) { $v = 5; } else { $v = "five"; }
    return "" . $v;
}
function flags(int $c): bool {
    if ($c > 0) { $f = true; } else { $f = false; }
    return $f;
}
if (pick(3) !== 9) { exit(1); }
if (pick(-1) !== 8) { exit(2); }
if (mixed_arms(1) !== "5") { exit(3); }
if (mixed_arms(0) !== "five") { exit(4); }
if (!flags(1) || flags(0)) { exit(5); }
$s = 0;
for ($i = 0; $i < 10; $i++) {
    if ($i % 2 == 0) { $d = $i; } else { $d = 0 - $i; }
    $s = $s + $d;
}
if ($s !== -5) { exit(6); }
println("ok");
