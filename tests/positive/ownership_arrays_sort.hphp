<?php
/* ownership_arrays_sort.hphp — sort family mutates the borrowed array in
 * place and returns a boolean; shuffle does the same (it used to return a new
 * array, which the declared bool return then threw away). */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$list = [3, 1, 2];
check("sort returns true", sort($list));
check("sort orders ascending", $list[0] == 1 && $list[1] == 2 && $list[2] == 3);

check("rsort returns true", rsort($list));
check("rsort orders descending", $list[0] == 3 && $list[1] == 2 && $list[2] == 1);

$map = ["b" => 2, "a" => 1, "c" => 3];
check("ksort returns true", ksort($map));
check("ksort orders keys", array_key_first($map) == "a");
check("krsort returns true", krsort($map));
check("krsort reverses keys", array_key_first($map) == "c");

$vals = ["x" => 2, "y" => 1];
check("asort returns true", asort($vals));
check("asort orders values, keeps keys", array_key_first($vals) == "y");

$u = [3, 1, 2];
$cmp = function($a, $b) { return $a - $b; };
check("usort returns true", usort($u, $cmp));
check("usort orders by the callback", $u[0] == 1 && $u[2] == 3);
check("uasort returns true", uasort($u, $cmp));
check("uksort returns true", uksort($u, $cmp));

$shuffled = [1, 2, 3, 4, 5, 6, 7, 8];
check("shuffle returns true", shuffle($shuffled));
check("shuffle keeps every element", count($shuffled) == 8 && in_array(8, $shuffled));
check("shuffle keeps the array (not a new value)", $shuffled[0] != 0);

echo "ownership arrays sort ok\n";
