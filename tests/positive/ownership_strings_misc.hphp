<?php
/* ownership_strings_misc.hphp — edge cases of the string group: custom trim
 * sets, negative offsets, zero repeats and length limits. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$text = "xxhelloxx";
$set = "x";

$r = ltrim($text, $set);
check("ltrim with a character set", $r == "helloxx");
unsafe { str_free($r); }
$r = rtrim($text, $set);
check("rtrim with a character set", $r == "xxhello");
unsafe { str_free($r); }
check("trim family left the input intact", $text == "xxhelloxx");

$r = substr("abcdef", -2);
check("substr negative start", $r == "ef");
unsafe { str_free($r); }
$r = substr("abcdef", 1, -1);
check("substr negative length", $r == "bcde");
unsafe { str_free($r); }
$r = substr("abcdef", 10, 2);
check("substr past the end is empty", $r == "");
unsafe { str_free($r); }

$r = str_repeat("ab", 0);
check("str_repeat 0 is empty", $r == "");
unsafe { str_free($r); }

$r = str_pad("abc", 6, "");
check("str_pad with an empty pad uses spaces", $r == "abc   ");
unsafe { str_free($r); }

check("strncmp stops at n", strncmp("abc", "abd", 2) == 0);
check("strncasecmp zero length", strncasecmp("abc", "xyz", 0) == 0);

$r = str_shuffle("");
check("str_shuffle of empty stays empty", $r == "");
unsafe { str_free($r); }

$r = strip_tags("plain");
check("strip_tags without tags copies", $r == "plain");
unsafe { str_free($r); }

if ($fail == 0) { echo "ownership strings misc ok\n"; } else { exit(1); }
