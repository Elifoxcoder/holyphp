// password_hash()/password_verify(): the encoder writes a 24-character
// base64 salt plus the terminating NUL, so the salt buffer needs 25 bytes.
// ASan used to report a stack-buffer-overflow here (STATUS.md, F3).
$hash = password_hash("secret");
$parts = explode("$", $hash);
// "", "hphp", rounds, salt, digest
if (count($parts) != 5) { exit(1); }
if ($parts[1] != "hphp") { exit(2); }
if ($parts[2] != "4096") { exit(3); }
if (strlen($parts[3]) != 24) { exit(4); }
if (strlen($parts[4]) != 44) { exit(5); }
if (password_verify("secret", $hash) !== true) { exit(6); }
if (password_verify("Secret", $hash) !== false) { exit(7); }
if (password_verify("", $hash) !== false) { exit(8); }

// long passwords and empty ones must round-trip too (HMAC block handling)
$long = str_repeat("x", 200);
$h2 = password_hash($long);
if (password_verify($long, $h2) !== true) { exit(9); }
$h3 = password_hash("");
if (password_verify("", $h3) !== true) { exit(10); }

// a malformed stored hash must be rejected, not crash
if (password_verify("x", "not-a-hash") !== false) { exit(11); }
if (password_verify("x", "") !== false) { exit(12); }

println("password_hash ok");
