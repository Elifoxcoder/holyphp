<?php
/* ownership_strings_case.hphp — comparison builtins borrow both arguments and
 * return scalars; the case builtins return a fresh string. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$a = "Hello";
$b = "hello";
$c = "help";
$hay = "the quick brown fox";
$needle = "quick";
$missing = "slow";

check("strcmp equal", strcmp($a, $a) == 0);
check("strcmp orders", strcmp($a, $b) < 0);
check("strcasecmp ignores case", strcasecmp($a, $b) == 0);
check("strncmp limits", strncmp($a, $b, 4) != 0);
check("strncasecmp limits", strncasecmp($a, $b, 4) == 0);
check("strncasecmp sees a difference", strncasecmp($a, $c, 4) < 0);

check("str_contains", str_contains($hay, $needle));
check("str_contains miss", !str_contains($hay, $missing));
check("str_starts_with", str_starts_with($hay, "the"));
check("str_ends_with", str_ends_with($hay, "fox"));
check("strpos finds", strpos($hay, $needle) == 4);
check("strpos misses", strpos($hay, $missing) === false);

$r = strstr($hay, $needle);
check("strstr from the needle", $r == "quick brown fox");
check("strstr left the input intact", $hay == "the quick brown fox");
$r = strchr($hay, $needle);
check("strchr alias", $r == "quick brown fox");
check("strstr miss returns false", strstr($hay, $missing) === false);

check("substr_count", substr_count($hay, "o") == 2);
check("ord", ord("A") == 65);
$r = chr(66);
check("chr value", $r == "B");

$r = ucwords("holy php");
check("ucwords value", $r == "Holy Php");

$r = str_shuffle("abcdef");
check("str_shuffle keeps the length", strlen($r) == 6);

check("similar_text counts matching characters", similar_text("hello", "hallo") == 4);
check("levenshtein distance", levenshtein("kitten", "sitting") == 3);

if ($fail == 0) { echo "ownership strings case ok\n"; } else { exit(1); }
