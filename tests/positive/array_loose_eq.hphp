<?php
/* == on arrays compares key/value pairs (PHP semantics), not identity */
$fail = 0;
function check(string $name, bool $ok): int {
    if ($ok) {
        echo "OK   " . $name;
        return 0;
    }
    echo "FAIL " . $name;
    return 1;
}
function eqm(mixed $a, mixed $b): bool { return $a == $b; }

$x = [1, 2];
$y = [1, 2];
$fail += check("equal lists", $x == $y);
$fail += check("equal literals", [1, 2] == [1, 2]);
$fail += check("through mixed", eqm([1, 2], [1, 2]));
$fail += check("different values", !([1, 2] == [1, 3]));
$fail += check("different lengths", !([1, 2] == [1, 2, 3]));
$fail += check("loose values", [1, "2"] == ["1", 2]);
$fail += check("maps in any order", ["a" => 1, "b" => 2] == ["b" => 2, "a" => 1]);
$fail += check("maps differ by key", !(["a" => 1] == ["b" => 1]));
$fail += check("nested", [[1, 2], ["k" => [3]]] == [[1, 2], ["k" => [3]]]);
$fail += check("nested differ", !([[1, 2]] == [[1, 9]]));
$fail += check("empty equals empty", [] == []);
$fail += check("!= is the negation", [1] != [2]);
$fail += check("=== keeps order", !(["a" => 1, "b" => 2] === ["b" => 2, "a" => 1]));
$fail += check("=== same order", ["a" => 1, "b" => 2] === ["a" => 1, "b" => 2]);
$fail += check("in_array finds arrays", in_array([1, 2], [[0], [1, 2]]));
if ($fail > 0) {
    exit(1);
}
