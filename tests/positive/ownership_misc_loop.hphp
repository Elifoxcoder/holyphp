<?php
/* ownership_misc_loop.hphp — string builders, typed int arrays and raw
 * memory: every handle is created and released in the same iteration. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$text = "ownership";
$acc = 0;
for ($round = 0; $round < 10; $round++) {
for ($i = 0; $i < 20000; $i++) {
    $sb = sb_new();
    sb_reserve($sb, 64);
    sb_put($sb, $text);
    sb_int($sb, $i);
    $acc += sb_len($sb);
    unsafe { $s = sb_take($sb); }
    $acc += strlen($s);

    $a = iarr_new(4);
    iarr_set($a, 0, $i);
    iarr_set($a, 1, $i + 1);
    $acc += iarr_get($a, 1);
    $acc += iarr_len($a) == 0 ? 1 : 0;
    unsafe { iarr_release($a); }

    unsafe {
        $p = malloc(32);
        memset($p, 0, 32);
        u8_set($p, 0, 65);
        i64_set($p, 1, $i);
        $acc += u8_at($p, 0);
        $acc += i64_at($p, 1);
        free($p);
    }
}
}
check("misc loop accumulated work", $acc > 0);
echo "ownership misc loop ok\n";
