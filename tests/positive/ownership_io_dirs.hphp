<?php
/* ownership_io_dirs.hphp — scandir/glob return an array of fresh strings;
 * releasing the elements and the array leaves the directory untouched. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$dir = sys_get_temp_dir();
$sub = $dir . "/hphp_ownership_dir_" . time();
check("mkdir", mkdir($sub));
check("is_dir", is_dir($sub));

$p1 = $sub . "/one.txt";
$p2 = $sub . "/two.txt";
file_put_contents($p1, "1");
file_put_contents($p2, "2");

$names = scandir($sub);
check("scandir finds both files", count($names) == 2);
check("scandir names are fresh strings", str_contains($names[0], ".txt"));
foreach ($names as $n) { unsafe { str_free($n); } }
unsafe { arr_free($names); }

$pattern = $sub . "/*.txt";
$paths = glob($pattern);
check("glob finds both files", count($paths) == 2);
foreach ($paths as $p) { unsafe { str_free($p); } }
unsafe { arr_free($paths); }

unlink($p1);
unlink($p2);
check("rmdir", rmdir($sub));
check("the directory is gone", !is_dir($sub));

unsafe { str_free($dir); str_free($sub); str_free($p1); str_free($p2); str_free($pattern); }
echo "ownership io dirs ok\n";
