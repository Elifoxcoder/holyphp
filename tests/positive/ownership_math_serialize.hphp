<?php
/* ownership_math_serialize.hphp — debug/serialization builtins return a new
 * string (they also print, like PHP). Releasing the result leaves the input
 * untouched. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$data = [1, 2];
$r = serialize($data);
check("serialize returned text", strlen($r) > 0);
check("serialize left the array intact", count($data) == 2);

$r = print_r($data);
check("print_r returned text", str_contains($r, "Array"));

$r = var_export($data);
check("var_export returned text", strlen($r) > 0);

var_dump($data);

$copy = [3, 4];
$r = serialize($copy);
$again = serialize($copy);
check("serialize is deterministic", $r == $again);

echo "ownership math serialize ok\n";
