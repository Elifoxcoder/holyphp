<?php
/* ownership_io_paths.hphp — path helpers return fresh strings (or an array);
 * the input path is borrowed. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$path = "/tmp/dir/file.txt";
$suffix = ".txt";

$r = dirname($path);
check("dirname value", $r == "/tmp/dir");
unsafe { str_free($r); }
$r = basename($path);
check("basename value", $r == "file.txt");
unsafe { str_free($r); }
$r = basename($path, $suffix);
check("basename strips the suffix", $r == "file");
unsafe { str_free($r); }

$info = pathinfo($path);
check("pathinfo basename", $info["basename"] == "file.txt");
check("pathinfo dirname", $info["dirname"] == "/tmp/dir");
check("pathinfo extension", $info["extension"] == "txt");
check("pathinfo filename", $info["filename"] == "file");
unsafe { arr_free($info); }

$dir = sys_get_temp_dir();
$name = "hphp_ownership_path.txt";
$joined = $dir . "/" . $name;
file_put_contents($joined, "x");
$real = realpath($joined);
check("realpath returns an existing path", file_exists($real));
unsafe { str_free($real); }
unlink($joined);

check("the path string survived", $path == "/tmp/dir/file.txt");
unsafe { str_free($dir); str_free($joined); }

echo "ownership io paths ok\n";
