<?php
/* ownership_misc_crypto.hphp — random_bytes returns a fresh binary string;
 * the comparison helper borrows both strings. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$n = 16;
$a = random_bytes($n);
$b = random_bytes($n);
check("random_bytes length", strlen($a) == 16 && strlen($b) == 16);
check("two draws differ", $a != $b);

$zero = random_bytes(0);
check("zero bytes is an empty string", $zero == "");

$one = "abc";
$two = "abc";
$three = "abd";
check("hash_equals accepts equal strings", hash_equals($one, $two));
check("hash_equals rejects different strings", !hash_equals($one, $three));
check("hash_equals left the inputs intact", $one == "abc" && $three == "abd");

$r = sha256($one);
check("sha256 is 64 hex characters", strlen($r) == 64);

echo "ownership misc crypto ok\n";
