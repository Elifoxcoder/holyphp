<?php
/* ownership_json_loop.hphp — JSON encoders return a fresh string; the field
 * readers return a scalar or a fresh string and borrow the JSON text. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$value = ["message" => "hello", "n" => 42, "ok" => true, "list" => [1, 2, 3]];
$json = json_encode($value);
$nameKey = "message";
$numKey = "n";
$acc = 0;
for ($round = 0; $round < 10; $round++) {
    for ($i = 0; $i < 20000; $i++) {
        $r = json_encode($value);
        $acc += strlen($r);
        $r = json_encode_pretty($value);
        $acc += strlen($r);
        $acc += json_num_field($json, $numKey);
        $s = json_str_field($json, $nameKey);
        $acc += strlen($s);
    }
}
check("json loop accumulated work", $acc > 0);
echo "ownership json loop ok\n";
