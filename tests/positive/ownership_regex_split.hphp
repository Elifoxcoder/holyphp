<?php
/* ownership_regex_split.hphp — preg_split returns an array of fresh strings;
 * invalid patterns split into a one-element array that owns a copy. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

function release_strings($a): void {
}

$subj = "a,b,c";
$parts = preg_split("/,/", $subj);
check("preg_split count", count($parts) == 3);
check("preg_split values", $parts[0] == "a" && $parts[2] == "c");
release_strings($parts);
check("preg_split left the subject intact", $subj == "a,b,c");

$parts = preg_split("/[ ]+/", "a   b  c");
check("preg_split on runs of spaces", count($parts) == 3);
release_strings($parts);

$parts = preg_split("/zzz/", $subj);
check("preg_split without a match returns one part", count($parts) == 1 && $parts[0] == $subj);
release_strings($parts);

$bad = "/[/";
$parts = preg_split($bad, $subj);
check("invalid pattern returns one part", count($parts) == 1 && $parts[0] == $subj);
release_strings($parts);

echo "ownership regex split ok\n";
