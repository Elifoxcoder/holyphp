<?php
/* ownership_strings_hashes.hphp — digest and password builtins return new
 * strings (or scalars) and never consume their inputs. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$text = "secret";
$key = "key";

$r = sha256($text);
check("sha256 is 64 hex characters", strlen($r) == 64);
check("sha256 left the input intact", $text == "secret");

$r = hash_hmac("sha256", $text, $key);
check("hash_hmac is 64 hex characters", strlen($r) == 64);
check("hash_hmac left both inputs intact", $text == "secret" && $key == "key");

$stable = hash_hmac("sha256", $text, $key);
$other = hash_hmac("sha256", "other", $key);
check("hash_hmac is deterministic", $stable == hash_hmac("sha256", $text, $key));
check("hash_equals accepts equal digests", hash_equals($stable, $stable));
check("hash_equals rejects different digests", !hash_equals($stable, $other));

$hash = password_hash("correct horse");
check("password_hash has the runtime format", str_starts_with($hash, '$hphp$'));
check("password_verify accepts the right password", password_verify("correct horse", $hash));
check("password_verify rejects a wrong password", !password_verify("wrong horse", $hash));
check("password_verify rejects an empty hash", !password_verify("correct horse", ""));

if ($fail == 0) { echo "ownership strings hashes ok\n"; } else { exit(1); }
