<?php
/* ownership_date_parse.hphp — strtotime borrows its string and returns a
 * scalar; the parsed value matches mktime for an ISO date. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$iso = "2024-02-29 12:00:00";
$ts = mktime(12, 0, 0, 2, 29, 2024);
check("strtotime ISO date", strtotime($iso) == $ts);
check("strtotime left the input intact", $iso == "2024-02-29 12:00:00");

$dateOnly = "2024-02-29";
check("strtotime date only", strtotime($dateOnly) == mktime(0, 0, 0, 2, 29, 2024));

$now = time();
$plus = strtotime("+1 day");
$minus = strtotime("-1 day");
check("strtotime +1 day is in the future", $plus > $now);
check("strtotime -1 day is in the past", $minus < $now);

$nowWord = "now";
check("strtotime now is close to time()", abs(strtotime($nowWord) - time()) <= 2);

$bad = "not a date";
check("strtotime failure returns 0", strtotime($bad) == 0);
check("the inputs survived", $iso == "2024-02-29 12:00:00" && $bad == "not a date");

unsafe { str_free($iso); str_free($dateOnly); str_free($nowWord); str_free($bad); }
echo "ownership date parse ok\n";
