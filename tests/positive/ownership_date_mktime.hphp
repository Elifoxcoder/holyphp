<?php
/* ownership_date_mktime.hphp — mktime takes numbers and returns a scalar;
 * the components survive the call. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$h = 12;
$m = 34;
$s = 56;
$mon = 2;
$day = 29;
$year = 2024;
$ts = mktime($h, $m, $s, $mon, $day, $year);
check("mktime produced a timestamp", $ts > 0);
check("mktime round trip year", date("Y", $ts) == "2024");
check("mktime round trip month", date("m", $ts) == "02");
check("mktime round trip day", date("d", $ts) == "29");
check("mktime round trip hour", date("H", $ts) == "12");
check("the components survived", $h == 12 && $year == 2024);

$next = mktime(0, 0, 0, 3, 1, 2024);
check("mktime next month", date("m-d", $next) == "03-01");

echo "ownership date mktime ok\n";
