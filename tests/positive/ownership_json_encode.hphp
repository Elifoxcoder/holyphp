<?php
/* ownership_json_encode.hphp — json_encode returns one fresh string and never
 * takes anything from the value. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$map = ["a" => 1, "b" => true, "c" => null, "d" => "x\"y", "e" => [1, 2]];
$r = json_encode($map);
check("json_encode map", $r == '{"a":1,"b":true,"c":null,"d":"x\"y","e":[1,2]}');
unsafe { str_free($r); }
check("json_encode left the map intact", count($map) == 5 && $map["a"] == 1);

$r = json_encode([1, 2, 3]);
check("json_encode list", $r == "[1,2,3]");
unsafe { str_free($r); }

$r = json_encode("plain");
check("json_encode string", $r == '"plain"');
unsafe { str_free($r); }

$r = json_encode(42);
check("json_encode int", $r == "42");
unsafe { str_free($r); }

$r = json_encode(1.5);
check("json_encode float", $r == "1.5");
unsafe { str_free($r); }

$r = json_encode(true);
check("json_encode true", $r == "true");
unsafe { str_free($r); }

$r = json_encode(null);
check("json_encode null", $r == "null");
unsafe { str_free($r); }

$r = json_encode([]);
check("json_encode empty list", $r == "[]");
unsafe { str_free($r); }

unsafe { arr_free($map); }
echo "ownership json encode ok\n";
