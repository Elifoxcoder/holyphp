$values = [3, 5, 7, 11, 13];
$sum = 0;
for ($i = 0; $i < count($values); $i++) {
    $sum += $values[$i];
}
if ($sum != 39) {
    throw "canonical counted loop changed result";
}

/* A write to the collection invalidates the proof and keeps checked access. */
$mut = [4, 6];
$mut_sum = 0;
for ($j = 0; $j < count($mut); $j++) {
    $mut_sum += $mut[$j];
    if ($j == 0) { $mut[] = 8; }
}
if ($mut_sum != 18) {
    throw "mutating counted loop changed result";
}
$map = [0 => 10, 1 => 20];
$map_sum = 0;
for ($m = 0; $m < count($map); $m++) {
    $map_sum += $map[$m];
}
if ($map_sum != 30) {
    throw "counted map lookup changed key semantics";
}
echo "index bounds elision ok";
