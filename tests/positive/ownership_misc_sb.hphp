<?php
/* ownership_misc_sb.hphp — a builder is a handle the caller owns: sb_take()
 * transfers its contents into a new string and frees the builder, sb_discard()
 * frees it without a string. The appended strings are borrowed. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$a = "hello";
$b = " world";
$num = 42;
$sb = sb_new();
check("sb_new returns a handle", $sb != 0);
check("sb_put", sb_put($sb, $a));
check("sb_put a second part", sb_put($sb, $b));
check("sb_int", sb_int($sb, $num));
check("sb_len", sb_len($sb) == strlen($a) + strlen($b) + 2);
unsafe { $s = sb_take($sb); }
check("sb_take contents", $s == "hello world42");
unsafe { str_free($s); }
check("the appended strings survived", $a == "hello" && $b == " world");

$sb = sb_new();
sb_put($sb, "a");
sb_prepend($sb, "x");
unsafe { $s = sb_take($sb); }
check("sb_prepend", $s == "xa");
unsafe { str_free($s); }

$sb = sb_new();
sb_put($sb, "{\"s\":");
sb_json_str($sb, "a\"b");
sb_put($sb, "}");
unsafe { $s = sb_take($sb); }
check("sb_json_str escapes", $s == "{\"s\":\"a\\\"b\"}");
unsafe { str_free($s); }

$sb = sb_new();
sb_reserve($sb, 1024);
sb_put($sb, "gone");
unsafe { check("sb_discard", sb_discard($sb)); }

unsafe { str_free($a); str_free($b); }
echo "ownership misc sb ok\n";
