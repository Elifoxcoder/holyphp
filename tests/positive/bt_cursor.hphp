<?php
/* bt_cursor.hphp — the bt_* B-tree cursor builtins against a tiny committed
 * fixture database (tests/positive/data/bt_fixture.db, built by
 * make_bt_fixture.py). The expectations are the fixture's rows:
 *
 *   users  1 alice, 2 bob, 3 carol, 4 dave, 5 erin
 *   posts  1..6, newest last (id is the rowid, so it is NULL in the record)
 *   likes  post 1: 3, post 2: 2, post 3: 1, post 4: 4, post 5: 0, post 6: 1
 *
 * The handles are raw pointers, hence the unsafe block. Every call is its own
 * statement: HolyPHP evaluates arguments right-to-left, so bt_cols() must run
 * before bt_col_int()/bt_col_off() in a separate statement.
 */

$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    return false;
}
function expect_int(string $name, int $got, int $want): void {
    global $fail;
    if (!check($name . " (" . $got . ")", $got == $want)) { $fail = $fail + 1; }
}

$src = "tests/positive/data/bt_fixture.db";
if (!file_exists($src)) {
    echo "FAIL fixture database missing: " . $src . "\n";
    exit(1);
}
$path = sys_get_temp_dir() . "/hphp_bt_fixture.db";
unlink($path);
if (!copy($src, $path)) {
    echo "FAIL cannot copy the fixture database\n";
    exit(1);
}

unsafe {
    $db = sqlite_open($path);
    if (!check("sqlite_open", $db != 0)) { $fail = $fail + 1; }

    /* ---- table cursor: rows, rowids, seek ---- */
    $t = bt_open($db, "users", 0);
    if (!check("bt_open users", $t != 0)) { $fail = $fail + 1; }
    expect_int("bt_root users", bt_root($db, "users", 0) != 0 ? 1 : 0, 1);

    $r = bt_first($t);
    $id = bt_rowid($t);
    expect_int("bt_first returns a row", $r, 1);
    expect_int("bt_first rowid", $id, 1);

    $r = bt_next($t);
    $id = bt_rowid($t);
    expect_int("bt_next returns a row", $r, 1);
    expect_int("bt_next rowid", $id, 2);

    $r = bt_last($t);
    $id = bt_rowid($t);
    expect_int("bt_last returns a row", $r, 1);
    expect_int("bt_last rowid", $id, 5);

    $r = bt_prev($t);
    $id = bt_rowid($t);
    expect_int("bt_prev returns a row", $r, 1);
    expect_int("bt_prev rowid", $id, 4);

    $r = bt_seek($t, 3);
    $id = bt_rowid($t);
    expect_int("bt_seek finds", $r, 1);
    expect_int("bt_seek rowid", $id, 3);
    $r = bt_seek($t, 99);
    expect_int("bt_seek beyond the end", $r, 0);

    /* ---- record decoding at rowid 3 ("carol") ---- */
    $r = bt_seek($t, 3);
    $n = bt_cols($t);
    expect_int("bt_cols", $n, 2);
    $off_id = bt_col_off(0);
    $len_id = bt_col_len(0);
    $off_name = bt_col_off(1);
    $len_name = bt_col_len(1);
    expect_int("id column is the rowid alias (NULL, offset)", $off_id, 3);
    expect_int("id column length", $len_id, 0);
    expect_int("username offset", $off_name, 3);
    expect_int("username length", $len_name, 5);
    expect_int("bt_col_int on the NULL id", bt_col_int(0), 0);

    $p = bt_payload_ptr($t);
    $size = bt_payload_size($t);
    expect_int("bt_payload_size", $size, 8);
    $name = "";
    for ($i = $off_name; $i < $off_name + $len_name; $i = $i + 1) {
        $name = $name . chr(u8_at($p, $i));
    }
    check("payload bytes spell carol", $name == "carol");

    /* ---- bt_read: serial type, offset, length, integer value ---- */
    $cols = iarr_new(8);
    $n = bt_read($t, $cols, 2);
    expect_int("bt_read column count", $n, 2);
    expect_int("bt_read id serial type (NULL)", iarr_get($cols, 0), 0);
    expect_int("bt_read id offset", iarr_get($cols, 1), 3);
    expect_int("bt_read id length", iarr_get($cols, 2), 0);
    expect_int("bt_read username serial type (text, 5 bytes)", iarr_get($cols, 4), 23);
    expect_int("bt_read username offset", iarr_get($cols, 5), 3);
    expect_int("bt_read username length", iarr_get($cols, 6), 5);
    iarr_release($cols);

    /* A pinned page keeps the payload valid while another cursor moves. */
    $pin = bt_payload_pin($t);
    check("bt_payload_pin", $pin != 0);
    if ($pin != 0) { bt_page_release($pin); }
    bt_close($t);

    /* ---- index cursor: count key and range ---- */
    $idx = bt_open($db, "likes_post_id_idx", 1);
    if (!check("bt_open index", $idx != 0)) { $fail = $fail + 1; }
    expect_int("bt_root index", bt_root($db, "likes_post_id_idx", 1) != 0 ? 1 : 0, 1);
    expect_int("likes for post 1", bt_count_key($idx, 1), 3);
    expect_int("likes for post 2", bt_count_key($idx, 2), 2);
    expect_int("likes for post 3", bt_count_key($idx, 3), 1);
    expect_int("likes for post 4", bt_count_key($idx, 4), 4);
    expect_int("likes for post 5", bt_count_key($idx, 5), 0);
    expect_int("likes for post 6", bt_count_key($idx, 6), 1);

    $hist = iarr_new(6);
    $rc = bt_count_range($idx, 1, 6, $hist);
    expect_int("bt_count_range result", $rc, 0);
    expect_int("range post 1", iarr_get($hist, 0), 3);
    expect_int("range post 2", iarr_get($hist, 1), 2);
    expect_int("range post 3", iarr_get($hist, 2), 1);
    expect_int("range post 4", iarr_get($hist, 3), 4);
    expect_int("range post 5", iarr_get($hist, 4), 0);
    expect_int("range post 6", iarr_get($hist, 5), 1);
    iarr_release($hist);
    bt_close($idx);

    /* ---- batched tail, multi seek ---- */
    $pcur = bt_open($db, "posts", 0);
    if (!check("bt_open posts", $pcur != 0)) { $fail = $fail + 1; }

    $tail = bt_tail($pcur, 2);
    if (!check("bt_tail result", $tail != 0)) { $fail = $fail + 1; }
    $keys = iarr_new(2);
    $n = bt_multi_keys($tail, $keys);
    expect_int("bt_multi_keys count", $n, 2);
    expect_int("tail first key (newest)", iarr_get($keys, 0), 6);
    expect_int("tail second key", iarr_get($keys, 1), 5);
    iarr_release($keys);
    $vals = iarr_new(6);
    check("bt_multi_payloads", bt_multi_payloads($tail, $vals));
    iarr_release($vals);
    bt_multi_release($tail);

    $want = iarr_new(3);
    iarr_set($want, 0, 1);
    iarr_set($want, 1, 9);   /* no such post */
    iarr_set($want, 2, 3);
    $multi = bt_multi_seek($pcur, $want, 3);
    if (!check("bt_multi_seek result", $multi != 0)) { $fail = $fail + 1; }
    $mkeys = iarr_new(3);
    $n = bt_multi_keys($multi, $mkeys);
    expect_int("bt_multi_keys order preserved", $n, 3);
    expect_int("multi key 0", iarr_get($mkeys, 0), 1);
    expect_int("multi key 1", iarr_get($mkeys, 1), 9);
    expect_int("multi key 2", iarr_get($mkeys, 2), 3);
    iarr_release($mkeys);
    $found = iarr_new(9);
    check("bt_multi_payloads flags", bt_multi_payloads($multi, $found));
    expect_int("post 1 found", iarr_get($found, 0), 1);
    expect_int("post 9 not found", iarr_get($found, 3), 0);
    expect_int("post 3 found", iarr_get($found, 6), 1);
    iarr_release($found);
    bt_multi_release($multi);
    iarr_release($want);
    bt_close($pcur);

    /* ---- close everything, then a second connection sees the same rows ---- */
    sqlite_close($db);
}
unlink($path);

if ($fail == 0) {
    echo "bt cursor OK\n";
} else {
    echo "bt cursor FAILED (" . $fail . ")\n";
    exit(1);
}
