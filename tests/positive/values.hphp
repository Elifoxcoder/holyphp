// values.hphp — regression suite for literals, PHP-style arithmetic and
// multi-line expressions.
// Run: hphp run tests/positive/values.hphp   (exit 0 = all good)
//
// Guards these formerly-broken behaviours:
//   * a map literal took its value type from the FIRST entry only, so
//     ["name" => "Elias", "alter" => 25] compiled the int entry as a string
//     (compiler crash / garbage values).
//   * int/float entries were "unified" to float, so [1, 2.5] read the int
//     slot's bits as a double (4.9e-324).
//   * expressions could not span lines, unlike PHP.

function check(bool $cond, string $what): void {
    if ($cond) {
        echo "OK   " . $what . "\n";
    } else {
        echo "FAIL " . $what . "\n";
        exit(1);
    }
}

// --- mixed-value maps -------------------------------------------------
$user = [
    "name" => "Elias",
    "alter" => 25,
];
check($user["name"] == "Elias", "map: string value");
check($user["alter"] == 25, "map: int value in a string map");
check(count($user) == 2, "map: count");

$mix = ["i" => 1, "f" => 2.5];
check($mix["i"] == 1, "map: int entry stays int");
check($mix["f"] == 2.5, "map: float entry stays float");
check($mix["i"] + $mix["f"] == 3.5, "map: mixed entries add");

// same key twice is not an error in either language — last wins
$cfg = [
    "host" => "localhost",
    "port" => 8080,
    "debug" => true,
];
check($cfg["port"] == 8080, "map: nested/int entry");
check($cfg["debug"] === true, "map: bool entry");

// --- mixed-value arrays ----------------------------------------------
$nums = [1, 2.5];
check($nums[0] == 1, "array: int entry stays int");
check($nums[1] == 2.5, "array: float entry stays float");
check($nums[0] + $nums[1] == 3.5, "array: mixed entries add");

$homog = [1, 2, 3];
check($homog[1] + 1 == 3, "array: homogeneous ints");
$floats = [1.5, 2.5];
check($floats[0] + $floats[1] == 4.0, "array: homogeneous floats");
$strs = ["a", "b"];
check($strs[0] . $strs[1] == "ab", "array: strings");

// --- PHP numeric-string arithmetic -----------------------------------
check("1" + "2" == 3, "'1' + '2' is numeric (PHP), not concatenation");
check("1.5" + 1 == 2.5, "'1.5' + 1");
check("10" - "4" == 6, "'10' - '4'");
check("3" * 4 == 12, "'3' * 4");
check("10" / 4 == 2.5, "'10' / 4");
check("  7  " + 1 == 8, "surrounding whitespace");

// --- ordinary arithmetic unchanged -----------------------------------
check(10 / 4 == 2.5, "int division is float (PHP)");
check(7 % 3 == 1, "modulo");
check(2 ** 10 == 1024, "power");
check(1 + 2 * 3 == 7, "precedence");

// --- multi-line expressions (PHP lets these span lines) --------------
$grid = [
    [1, 2],
    [3, 4],
];
check($grid[1][0] == 3, "nested array literal across lines");

$total = 1 +
         2 +
         3;
check($total == 6, "arithmetic across lines");

$word = "a"
      . "b"
      . "c";
check($word == "abc", "concatenation across lines");

$merged = array_merge(
    [1, 2],
    [3, 4]
);
check(count($merged) == 4, "call arguments across lines");

function scale(
    int $n,
    int $by
): int {
    return $n * $by;
}
check(scale(
    6,
    7
) == 42, "declaration and call across lines");

// --- user functions live in their own namespace ----------------------
// (a user `add` must not collide with the runtime's hp_add)
function add(int $a, int $b): int { return $a + $b; }
function count_of(int $n): int { return $n; }
check(add(20, 22) == 42, "user function named like a builtin helper");
check(count_of(3) == 3, "user function named count_of");

echo "ALL VALUE CHECKS PASSED\n";
