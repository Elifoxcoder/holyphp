<?php
/* ownership_json_fields.hphp — the fast field readers borrow the JSON text
 * and return a scalar or a fresh string. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$json = '{"id":1234,"name":"ann","escaped":"a\\nb","neg":-7,"quoted":"7"}';
$idKey = "id";
$nameKey = "name";
$escKey = "escaped";
$negKey = "neg";
$quotedKey = "quoted";
$missing = "nope";

check("json_num_field", json_num_field($json, $idKey) == 1234);
check("json_num_field negative", json_num_field($json, $negKey) == -7);
check("json_num_field missing", json_num_field($json, $missing) == -1);

$r = json_str_field($json, $nameKey);
check("json_str_field value", $r == "ann");
$r = json_str_field($json, $quotedKey);
check("json_str_field keeps a numeric string", $r == "7");
$r = json_str_field($json, $escKey);
check("json_str_field unescapes", $r == "a\nb");
$r = json_str_field($json, $missing);
check("json_str_field missing is empty", $r == "");

check("the JSON text survived", str_contains($json, "\"name\":\"ann\""));

echo "ownership json fields ok\n";
