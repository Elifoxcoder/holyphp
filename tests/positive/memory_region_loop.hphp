<?php
declare(enforce_memory_safety=1);

function iteration_regions(): int {
    $total = 0;
    for ($i = 0; $i < 20; $i++) {
        let $text: string = "row-" . $i;
        let $items: array = [1, 2, 3];
        $total += strlen($text) + array_sum($items);
        if ($i == 3) { continue; }
        if ($i == 12) { break; }
    }
    return $total;
}

function nested_iteration_regions(): int {
    $total = 0;
    for ($i = 0; $i < 5; $i++) {
        let $outer: string = "o" . $i;
        for ($j = 0; $j < 5; $j++) {
            let $inner: string = "i" . $j;
            let $items: array = [1, 2];
            $total += strlen($outer) + strlen($inner) + array_sum($items);
            if ($j == 0) { continue; }
            if ($j == 2) { break; }
        }
        if ($i == 2) { break; }
    }
    return $total;
}

function return_from_iteration_region(): int {
    for ($i = 0; $i < 5; $i++) {
        let $text: string = "row-" . $i;
        let $items: array = [3, 4];
        if ($i == 1) { return strlen($text) + array_sum($items); }
    }
    return 0;
}

if (iteration_regions() != 146) { exit(1); }
if (nested_iteration_regions() != 63) { exit(2); }
if (return_from_iteration_region() != 12) { exit(3); }
echo "loop regions ok\n";
