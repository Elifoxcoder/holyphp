<?php
/* ownership_net_http.hphp — HTTP helpers borrow their strings and return a
 * fresh value or false; an unusable URL fails without allocating a result. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$bad = "not a url";
check("http_get rejects a bad URL", http_get($bad) === false);
check("http_request rejects a bad URL", http_request($bad, "GET", "", []) === false);
check("http_post rejects a bad URL", http_post($bad, "", []) === false);
check("the inputs survived", $bad == "not a url");

$method = "GET";
$body = "";
$headers = [];
check("http_request keeps its method argument", $method == "GET");
check("http_request keeps its body argument", $body == "" && count($headers) == 0);

unsafe { str_free($bad); str_free($method); str_free($body); arr_free($headers); }
echo "ownership net http ok\n";
