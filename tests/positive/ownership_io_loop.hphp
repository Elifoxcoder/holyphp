<?php
/* ownership_io_loop.hphp — file builtins return fresh strings/scalars; the
 * loop reads one tiny temp file, releases every result and must stay flat. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$dir = sys_get_temp_dir();
$sep = "/";
$name = "hphp_ownership_io.txt";
$path = $dir . $sep . $name;
$payload = "ownership";
file_put_contents($path, $payload);

$acc = 0;
for ($i = 0; $i < 20000; $i++) {
    $r = file_get_contents($path);
    $acc += strlen($r);
    $acc += filesize($path);
    $acc += file_exists($path) ? 1 : 0;
    $acc += is_file($path) ? 1 : 0;
    $acc += is_readable($path) ? 1 : 0;
    $acc += is_writable($path) ? 1 : 0;
    $r = realpath($path);
    $acc += strlen($r);
    $r = dirname($path);
    $acc += strlen($r);
    $r = basename($path, $name);
    $acc += strlen($r);
}
unlink($path);
check("io loop accumulated work", $acc > 0);
echo "ownership io loop ok\n";
