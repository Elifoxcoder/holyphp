<?php
/* ownership_io_process.hphp — shell_exec/exec return a fresh string; the
 * command string is borrowed. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$cmd = "echo ownership-process";
$out = shell_exec($cmd);
check("shell_exec returned the command output", str_contains($out, "ownership-process"));
check("shell_exec left the command intact", $cmd == "echo ownership-process");

$out = exec($cmd);
check("exec returned a string", is_string($out));

$falseCmd = "exit 1";
$out = shell_exec($falseCmd);
check("a failing command still returns a string", is_string($out));

echo "ownership io process ok\n";
