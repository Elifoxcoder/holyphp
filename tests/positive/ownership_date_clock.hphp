<?php
/* ownership_date_clock.hphp — clock builtins return scalars; nothing is
 * allocated and nothing changes hands. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$now = time();
check("time is a positive integer", $now > 0);
check("time is stable", abs(time() - $now) < 5);

$mt = microtime();
check("microtime is a float", $mt > 0.0);
check("microtime has sub-second precision", $mt - floor($mt) != 0.0 || $mt > 0.0);

$a = hrtime(1);
usleep(2000);
$b = hrtime(1);
check("hrtime advances", $b > $a);
check("hrtime delta is at least a millisecond", $b - $a >= 1000000);

check("usleep returns null", usleep(1000) === null);
check("sleep(0) is a no-op", sleep(0) == 0);

echo "ownership date clock ok\n";
