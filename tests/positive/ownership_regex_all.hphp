<?php
/* ownership_regex_all.hphp — preg_match_all returns columns of fresh strings;
 * free the inner arrays first, then the outer one. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$pat = "/[a-z]+/";
$subj = "ab cd ef";
$n = preg_match_all($pat, $subj, $all);
check("preg_match_all count", $n == 3);
check("outer array has a column", count($all) >= 1);
check("column 0 holds every match", count($all[0]) == 3);
check("match values", $all[0][0] == "ab" && $all[0][2] == "ef");
foreach ($all as $col) {
}
check("the subject survived", $subj == "ab cd ef");

$n = preg_match_all("/zzz/", $subj, $none);
check("no matches", $n == 0 && count($none[0]) == 0);

echo "ownership regex all ok\n";
