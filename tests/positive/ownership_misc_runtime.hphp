<?php
/* ownership_misc_runtime.hphp — diagnostics return scalars or fresh strings;
 * the compatibility counters are plain reads. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

check("memory_get_usage is an int", is_int(memory_get_usage()));
check("memory_get_peak_usage is an int", is_int(memory_get_peak_usage()));
check("live_allocs is an int", is_int(live_allocs()));
check("live_bytes is an int", is_int(live_bytes()));
check("gc_collect_cycles returns 0", gc_collect_cycles() == 0);

$r = runtime_stats();
check("runtime_stats returns JSON text", str_contains($r, "{") && str_contains($r, "live_allocs"));

unsafe {
    $h = heap_dump(null);
    check("heap_dump returns a string", is_string($h));
    }

check("runtime_diag_write is a bool", is_bool(runtime_diag_write("ownership test")));
check("phpversion is a string", strlen(phpversion()) > 0);
check("php_uname is a string", strlen(php_uname()) > 0);

$u = php_uname();
check("php_uname value is fresh", strlen($u) > 0);

echo "ownership misc runtime ok\n";
