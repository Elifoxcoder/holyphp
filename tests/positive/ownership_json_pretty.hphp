<?php
/* ownership_json_pretty.hphp — json_encode_pretty also returns one fresh
 * string; the compact intermediate is released internally. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$value = ["a" => 1, "b" => [1, 2]];
$r = json_encode_pretty($value);
check("pretty output has newlines", str_contains($r, "\n"));
check("pretty output is indented", str_contains($r, "    "));
check("pretty output keeps the keys", str_contains($r, "\"a\"") && str_contains($r, "\"b\""));
check("pretty output is longer than compact", strlen($r) > strlen(json_encode($value)));
check("pretty left the value intact", count($value) == 2 && count($value["b"]) == 2);

$r = json_encode_pretty([]);
check("pretty empty list stays compact", $r == "[]");

echo "ownership json pretty ok\n";
