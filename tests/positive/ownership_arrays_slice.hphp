<?php
/* ownership_arrays_slice.hphp — array-producing builtins return a fresh array
 * whose elements are shared with the input (strings are immutable, ints are
 * values). Freeing the result array must not touch the input. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$nums = [1, 2, 3, 4, 5];
$r = array_slice($nums, 1, 3);
check("array_slice values", count($r) == 3 && $r[0] == 2 && $r[2] == 4);
check("array_slice left the input intact", count($nums) == 5 && $nums[0] == 1);

$r = array_reverse($nums);
check("array_reverse values", $r[0] == 5 && $r[4] == 1);

$dup = [1, 2, 2, 3, 1];
$r = array_unique($dup);
check("array_unique removes duplicates", count($r) == 3);

$r = array_flip([10, 20]);
check("array_flip swaps key and value", $r[10] == 0 && $r[20] == 1);

$r = array_fill(2, 3, 7);
check("array_fill count", count($r) == 3);
check("array_fill value", $r[2] == 7 && $r[4] == 7);

$r = array_combine(["a", "b"], [1, 2]);
check("array_combine values", $r["a"] == 1 && $r["b"] == 2);

$r = array_pad([1, 2], 4, 9);
check("array_pad grows", count($r) == 4 && $r[3] == 9);

$r = array_replace(["a" => 1, "b" => 2], ["b" => 3, "c" => 4]);
check("array_replace values", $r["a"] == 1 && $r["b"] == 3 && $r["c"] == 4);

$r = array_merge([1, 2], [3, 4]);
check("array_merge values", count($r) == 4 && $r[0] == 1 && $r[3] == 4);

$r = array_chunk([1, 2, 3, 4, 5], 2);
check("array_chunk outer count", count($r) == 3);
check("array_chunk inner values", count($r[0]) == 2 && $r[0][0] == 1 && $r[2][0] == 5);

check("the source arrays survived", count($nums) == 5 && count($dup) == 5);
echo "ownership arrays slice ok\n";
