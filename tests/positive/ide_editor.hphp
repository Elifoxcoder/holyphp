// tests/positive/ide_editor.hphp — lib/ide: the document model of the editor.
// No window, no canvas: every check drives the buffer through its API, the
// way the workbench's key handler does.
//
// Run: hphp run tests/positive/ide_editor.hphp   (exit 0 = all good)

import "ide";

function check(bool $cond, string $what): void {
    if ($cond) {
        echo "OK   " . $what . "\n";
    } else {
        echo "FAIL " . $what . "\n";
        exit(1);
    }
}

function caret(IdeEditor $e, int $r, int $c) {
    $e->row = $r;
    $e->col = $c;
    $e->clear_sel();
}

function type_text(IdeEditor $e, string $s) {
    for ($i = 0; $i < strlen($s); $i++) { $e->type_char(substr($s, $i, 1)); }
}

/* ---- buffer + files -------------------------------------------------- */
$e = new IdeEditor();
$e->set_text("one\ntwo\nthree");
check($e->line_count() == 3, "set_text splits into lines");
check($e->line(1) == "two", "line text");
check($e->text() == "one\ntwo\nthree\n", "text() ends with a newline");

$path = "build/ide_editor_tmp.txt";
$e->buf->path = $path;
check($e->save(), "save to a file");
$e2 = new IdeEditor();
check($e2->load($path), "load the file back");
check($e2->text() == $e->text(), "round trip is lossless");
check(!$e2->buf->dirty, "a freshly loaded buffer is clean");
unlink($path);

/* ---- typing, undo, redo ---------------------------------------------- */
$e = new IdeEditor();
$e->set_text("");
type_text($e, "hello");
check($e->line(0) == "hello", "typing inserts at the caret");
type_text($e, " world");
check($e->line(0) == "hello world", "typing continues");
/* Runs group by word and by space: one undo removes the word, the next the
 * space in front of it, the next the first word - never the whole line. */
$e->undo_step();
check($e->line(0) == "hello ", "one undo removes the last word typed");
$e->undo_step();
check($e->line(0) == "hello", "the next removes the space");
$e->undo_step();
check($e->line(0) == "", "and the first removes the first word");
$e->redo_step();
check($e->line(0) == "hello", "redo replays the first run");
$e->redo_step();
check($e->line(0) == "hello ", "redo replays the space");
$e->redo_step();
check($e->line(0) == "hello world", "redo replays the second word");

/* a movement breaks the run: the next typing is its own undo step */
caret($e, 0, 0);
$e->move("end", false);
type_text($e, "!");
$e->undo_step();
check($e->line(0) == "hello world", "an edit after a move undoes on its own");

/* ---- newline, auto-indent, outdent ----------------------------------- */
$e = new IdeEditor();
$e->set_text("function f(): void {\n");
caret($e, 0, strlen($e->line(0)));
$e->newline();
check($e->row == 1 && $e->col == 4, "Enter after { indents one level");
type_text($e, "echo 1;");
$e->newline();
check($e->col == 4, "the new line keeps the indent");
type_text($e, "}");
check($e->line(2) == "}", "typing } on its own indented line lines it up");
check($e->col == 1, "and the caret follows it");
$e->newline();
check($e->row == 3 && $e->col == 0, "Enter after } keeps the closing level");
$e->undo_step();
$e->undo_step();
check($e->line(2) == "    ", "the closing brace step is undoable");

/* ---- backspace and delete -------------------------------------------- */
$e = new IdeEditor();
$e->set_text("ab\ncd");
caret($e, 1, 0);
$e->backspace();
check($e->line_count() == 1 && $e->line(0) == "abcd", "backspace at column 0 joins lines");
check($e->col == 2 && $e->row == 0, "the caret lands on the join");
$e->undo_step();
check($e->line_count() == 2 && $e->line(1) == "cd", "joining is undoable");

caret($e, 0, 2);
$e->delete_forward();
check($e->line_count() == 1 && $e->line(0) == "abcd", "delete at the end of a line joins");
check($e->row == 0 && $e->col == 2, "the caret stays where it was");
$e->undo_step();
check($e->line_count() == 2 && $e->line(1) == "cd", "and the join is undoable");

$e = new IdeEditor();
$e->set_text("    x = 1;");
caret($e, 0, strlen($e->line(0)));
$e->backspace();
check($e->line(0) == "    x = 1", "backspace at the end removes the last char");
check($e->col == 9, "and the caret follows it");
caret($e, 0, 4);
$e->backspace();
check($e->line(0) == "x = 1", "backspace inside the indent removes a whole step");
check($e->col == 0, "the caret lands at the start of the step");
caret($e, 0, 0);
$e->backspace();
check($e->line(0) == "x = 1", "backspace at the very start is a no-op");

/* ---- indent and outdent on a selection -------------------------------- */
$e = new IdeEditor();
$e->set_text("a\nb\nc");
caret($e, 0, 0);
$e->row = 2; $e->col = 0; $e->hasSel = true; $e->arow = 0; $e->acol = 0;
$e->shift_lines(1);
check($e->line(0) == "    a" && $e->line(2) == "    c", "indent the selected lines");
$e->shift_lines(-1);
check($e->line(0) == "a" && $e->line(2) == "c", "outdent them again");
$e->undo_step();
check($e->line(0) == "    a", "indenting a block undoes in one step");

$e = new IdeEditor();
$e->set_text("x");
caret($e, 0, 1);
$e->tab_key(false);
check($e->line(0) == "x   " && $e->col == 4, "Tab pads to the next stop");

/* ---- comment toggle --------------------------------------------------- */
$e = new IdeEditor();
$e->set_text("one\ntwo");
caret($e, 0, 0);
$e->row = 1; $e->col = 3; $e->hasSel = true; $e->arow = 0; $e->acol = 0;
$e->toggle_comment();
check($e->line(0) == "// one" && $e->line(1) == "// two", "Ctrl+/ comments the block");
$e->toggle_comment();
check($e->line(0) == "one" && $e->line(1) == "two", "and uncomments it");

/* ---- movement and selection ------------------------------------------ */
$e = new IdeEditor();
$e->set_text("alpha beta\ngamma delta\nepsilon");
caret($e, 0, 0);
$e->move("wordright", false);
check($e->col == 6, "word right");
$e->move("wordleft", false);
check($e->col == 0, "word left");
$e->move("end", false);
$e->move("down", false);
check($e->row == 1 && $e->col == 10, "down keeps the column");
$e->move("docend", false);
check($e->row == 2 && $e->col == 7, "document end");
$e->move("docstart", false);
check($e->row == 0 && $e->col == 0, "document start");

caret($e, 0, 0);
$e->move("right", true);
$e->move("right", true);
$e->move("right", true);
check($e->hasSel && $e->sel_text() == "alp", "shift+right selects");
$e->move("left", true);
check($e->sel_text() == "al", "shift+left shrinks the selection");
$e->clear_sel();
$e->move("right", false);
check($e->col == 3 && !$e->hasSel, "a plain move drops the selection and keeps going");

caret($e, 0, 0);
$e->move("down", true);
$e->move("end", true);
check($e->sel_text() == "alpha beta\ngamma delta", "a multi-line selection spans lines");
$e->delete_sel();
check($e->line_count() == 2 && $e->line(0) == "" && $e->line(1) == "epsilon",
      "deleting the selection leaves the line below at the top");
check($e->row == 0 && $e->col == 0, "the caret lands where the selection started");

$e = new IdeEditor();
$e->set_text("x\ny");
$e->select_all();
check($e->sel_text() == "x\ny", "select all");
$e->delete_sel();
check($e->line_count() == 1 && $e->line(0) == "", "delete all leaves one empty line");
$e->undo_step();
check($e->sel_text() == "" && $e->text() == "x\ny\n", "and it is undoable");

/* ---- auto-close ------------------------------------------------------- */
$e = new IdeEditor();
$e->set_text("");
type_text($e, "f(");
check($e->line(0) == "f()" && $e->col == 2, "typing ( closes the bracket");
type_text($e, ")");
check($e->line(0) == "f()" && $e->col == 3, "typing ) steps over the existing one");
type_text($e, "\"");
check($e->line(0) == "f()\"\"" && $e->col == 4, "a quote opens and closes around the caret");

/* ---- paste ------------------------------------------------------------ */
$e = new IdeEditor();
$e->set_text("    start();");
caret($e, 0, 4);
$e->insert("a\nb");
check($e->line(0) == "    a", "a pasted line keeps the indent");
check($e->line(1) == "    bstart();", "the last pasted line takes the tail");
check($e->row == 1 && $e->col == 5, "the caret lands after the paste");

/* ---- syntax ----------------------------------------------------------- */
$sc = ide_scan_line("function f(int \$n): void { return \$n; } // done", 0);
$kinds = "";
for ($i = 0; $i < count($sc->tokens); $i++) {
    if ($sc->tokens[$i]->kind == "ws") { continue; }
    $kinds = $kinds . $sc->tokens[$i]->kind . " ";
}
check($kinds == "kw fn op ty var op op ty op kw var op op com ", "token kinds of a whole line");

$sc2 = ide_scan_line("x = \"a # b\"; # tail", 0);
$strs = 0;
$coms = 0;
for ($i = 0; $i < count($sc2->tokens); $i++) {
    if ($sc2->tokens[$i]->kind == "str") { $strs = $strs + 1; }
    if ($sc2->tokens[$i]->kind == "com") { $coms = $coms + 1; }
}
check($strs == 1, "a # inside a string is not a comment");
check($coms == 1, "a # after the string is");

/* a block comment that runs over lines keeps its state */
$sa = ide_scan_line("a = 1; /* open", 0);
check($sa->state == 1, "an unclosed /* leaves the line in comment state");
$sb = ide_scan_line("still inside */ b = 2;", $sa->state);
$mid = 0;
for ($i = 0; $i < count($sb->tokens); $i++) {
    if ($sb->tokens[$i]->kind == "com") { $mid = $mid + 1; }
}
check($mid == 1 && $sb->state == 0, "the continuation line closes the comment");

$e = new IdeEditor();
$e->set_text("/*\ninside\n*/\nx = 1;\n");
$toks = $e->line_tokens(1);
check(count($toks) == 1 && $toks[0]->kind == "com", "a line inside a block comment is all comment");
check($e->line_tokens(3)[0]->kind == "id", "and the line after it is code again");

$e->viewRows = 2;
$e->scrollRow = 0;
check(count($e->highlight_window()) == 2, "the highlight window covers the viewport");

/* ---- completion ------------------------------------------------------- */
$e = new IdeEditor();
$e->set_text("function widget() { return 1; }\n\$widget = 2;\nwid\n");
caret($e, 2, 3);
check($e->word_at_cursor() == "wid", "the word at the cursor");
$opts = $e->completions("wid", 5);
check(count($opts) >= 1 && $opts[0] == "widget", "completions are sorted and match");
$e->complete_with("widget");
check($e->line(2) == "widget" && $e->col == 6, "accepting a completion replaces the word");
$e->undo_step();
check($e->line(2) == "wid", "and is undoable");

/* ---- brackets --------------------------------------------------------- */
$e = new IdeEditor();
$e->set_text("f(\n    g(1),\n    2,\n)");
caret($e, 0, 1);
$m = $e->match_bracket();
check($m[0] == 3 && $m[1] == 0, "the opening bracket matches across lines");
caret($e, 3, 0);
$m2 = $e->match_bracket();
check($m2[0] == 0 && $m2[1] == 1, "and the closing one matches back");

/* ---- scrolling -------------------------------------------------------- */
$e = new IdeEditor();
$lines: [string];
for ($i = 0; $i < 40; $i++) { $lines[] = "line " . $i; }
$e->set_text(implode("\n", $lines));
$e->viewRows = 10;
caret($e, 25, 0);
$e->ensure_cursor_visible();
check($e->scrollRow == 16, "the viewport follows the caret down");
caret($e, 0, 0);
$e->ensure_cursor_visible();
check($e->scrollRow == 0, "and back up");

check($e->status() == "Ln 1, Col 1", "the status line");

echo "ide editor ok\n";
