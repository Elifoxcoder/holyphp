<?php
/* ownership_json_roundtrip.hphp — encode then decode; both results are fresh
 * and releasing them does not touch the source value. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

function release_tree($v): void {
    if (is_array($v)) {
        foreach ($v as $k => $x) {
            release_tree($x);
            if (is_string($k)) { unsafe { str_free($k); } }
        }
        unsafe { arr_free($v); }
    } else if (is_string($v)) {
        unsafe { str_free($v); }
    }
}

$source = ["n" => 7, "s" => "hello", "list" => [1, 2]];
$json = json_encode($source);
$back = json_decode($json);
check("round trip keeps the number", $back["n"] == 7);
check("round trip keeps the string", $back["s"] == "hello");
check("round trip keeps the list", count($back["list"]) == 2 && $back["list"][1] == 2);
release_tree($back);
unsafe { str_free($json); }
check("round trip left the source intact", count($source) == 3 && $source["s"] == "hello");

$empty = [];
$json = json_encode($empty);
check("empty list round trip text", $json == "[]");
$back = json_decode($json);
check("empty list round trip value", is_array($back) && count($back) == 0);
unsafe { arr_free($back); str_free($json); }

unsafe { arr_free($source); arr_free($empty); }
echo "ownership json roundtrip ok\n";
