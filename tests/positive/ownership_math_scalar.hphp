<?php
/* ownership_math_scalar.hphp — arithmetic builtins take numbers by value and
 * return scalars; there is no heap ownership to transfer. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

check("abs int", abs(-7) == 7);
check("abs float", abs(-2.5) == 2.5);
check("round", round(2.6) == 3);
check("round precision", round(2.345, 2) == 2.35);
check("floor", floor(2.9) == 2);
check("ceil", ceil(2.1) == 3);
check("intdiv", intdiv(9, 2) == 4);
check("intdiv negative", intdiv(-9, 2) == -4);
check("fmod", fmod(9.0, 4.0) == 1.0);
check("pow int", pow(2, 10) == 1024);
check("pow negative exponent", pow(2, -1) == 0.5);
check("min of scalars", min(5, 3, 7) == 3);
check("max of scalars", max(5, 3, 7) == 7);
check("min of an array", min([4, 2, 6]) == 2);
check("max of an array", max([4, 2, 6]) == 6);

$nums = [3, 9, 1];
check("min borrowed the array", min($nums) == 1);
check("max borrowed the array", max($nums) == 9);
check("the array is intact", $nums[0] == 3 && $nums[2] == 1);

echo "ownership math scalar ok\n";
