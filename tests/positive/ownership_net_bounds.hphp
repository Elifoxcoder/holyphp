<?php
/* ownership_net_bounds.hphp — http_request_bounds parses a borrowed string in
 * place and returns one packed integer; nothing is allocated. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$mask = 2097151;   /* (1 << 21) - 1 */
$req = "GET /feed?x=1 HTTP/1.1\r\nHost: example\r\n\r\n";
$v = http_request_bounds($req);
check("bounds found the end", $v > 0);
$sp1 = $v & $mask;
$sp2 = ($v >> 21) & $mask;
$he = ($v >> 42) & $mask;
check("request-line first space", $sp1 == 3);
check("request-line second space", $sp2 == 13);
check("header end follows the second space", $he > $sp2);
check("the request survived", $req == "GET /feed?x=1 HTTP/1.1\r\nHost: example\r\n\r\n");

$short = "GET / HT";
check("incomplete request is negative", http_request_bounds($short) < 0);
$bad = "GET\r\n\r\n";
check("bad request line is negative", http_request_bounds($bad) < 0);

check("the inputs survived", $short == "GET / HT" && $bad == "GET\r\n\r\n");
unsafe { str_free($req); str_free($short); str_free($bad); }
echo "ownership net bounds ok\n";
