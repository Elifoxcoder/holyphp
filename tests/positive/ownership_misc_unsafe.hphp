<?php
/* ownership_misc_unsafe.hphp — the raw memory block belongs to the caller:
 * malloc() hands it out and free() gives it back. The accessors only borrow
 * the address; str_from_bytes() copies out of it. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$text = "hello";
$len = 5;
unsafe {
    $p = malloc(64);
    check("malloc returned an address", $p !== null);

    $src = malloc(8);
    u8_set($src, 0, 104);
    u8_set($src, 1, 101);
    u8_set($src, 2, 108);
    u8_set($src, 3, 108);
    u8_set($src, 4, 111);
    $copy = str_from_bytes($src, $len);
    check("str_from_bytes copied the bytes", $copy == "hello");
    str_free($copy);

    memset($p, 65, 4);
    check("memset wrote the byte", u8_at($p, 0) == 65 && u8_at($p, 3) == 65);

    u8_set($p, 4, 66);
    check("u8_set/u8_at", u8_at($p, 4) == 66);

    i64_set($p, 1, 123456789);
    check("i64_set/i64_at", i64_at($p, 1) == 123456789);

    free($src);
    free($p);
}
check("the source string survived", $text == "hello");
unsafe { str_free($text); }
echo "ownership misc unsafe ok\n";
