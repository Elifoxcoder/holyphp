// regress.hphp — regression suite for value semantics & operators.
// Run: hphp run tests/positive/regress.hphp   (exit 0 = all good)
// check() prints OK/FAIL and exits(1) on the first failure.

function check(bool $cond, string $what): void {
    if ($cond) {
        echo "OK   " . $what . "\n";
    } else {
        echo "FAIL " . $what . "\n";
        exit(1);
    }
}

// --- string equality (== was once inverted) ---
$a = "abc";
check($a == "abc", "eq: \$a == 'abc'");
check(!($a != "abc"), "neq: \$a != 'abc' is false");
check($a == "ab" . "c", "eq: concat equals literal");
check($a != "xyz", "neq on different strings");
check("A" != "a", "case matters");

// --- numeric comparisons ---
check(2 < 10, "2 < 10 (no string compare trap)");
check(10 > 2, "10 > 2");
check(1 + 1 == 2, "1+1 == 2");
check(7 % 3 == 1, "7 % 3 == 1");
check(2 ** 10 == 1024, "2 ** 10 == 1024");
check(7 / 2 == 3.5, "7 / 2 == 3.5 (float division)");

// --- array append: $a[] = v ---
$xs = [1, 2];
$xs[] = 3;
$xs[] = 7;
check(count($xs) == 4, "append grows count");
check(implode(",", $xs) == "1,2,3,7", "append order 1,2,3,7");

$names = [];
$names[] = "Elias";
$names[] = "Fuchs";
check($names[0] == "Elias" && $names[1] == "Fuchs", "append into empty array");

// --- value semantics: copy then mutate ---
$orig = [1, 2];
$copy = $orig;
$copy[] = 3;
check(count($orig) == 2, "copy-on-append: original untouched");
check(count($copy) == 3, "copy-on-append: copy grown");

$orig[0] = 99;
check($copy[0] == 1, "index write isolates after copy");

// --- value semantics: function args ---
function first_to_500(array $in): array {
    $in[0] = 500;
    return $in;
}
$vec = [1, 2, 3];
$out = first_to_500($vec);
check($out[0] == 500, "function mutated its local copy");
check($vec[0] == 1, "caller array isolated from function");

// --- nested containers copy deeply ---
$map = ["k" => ["x" => 1]];
$map2 = $map;
$map2["k"]["x"] = 9;
check($map["k"]["x"] == 1, "nested map isolated from copy");
check($map2["k"]["x"] == 9, "nested copy carries the write");

// --- in-place builtins still mutate their own variable ---
$srt = [3, 1, 2];
sort($srt);
check(implode(",", $srt) == "1,2,3", "sort() ascending");
rsort($srt);
check(implode(",", $srt) == "3,2,1", "rsort() descending");
array_push($srt, 0);
check(implode(",", $srt) == "3,2,1,0", "array_push appends");
check(max(3, 9, 1) == 9, "max(3,9,1)");
check(min(3, 9, 1) == 1, "min(3,9,1)");
check(array_sum([1, 2, 3]) == 6, "array_sum");

// --- string helpers used by real programs ---
check(strlen("Schatzsuche") == 11, "strlen");
check(strtoupper("hphp") == "HPHP", "strtoupper");
check(substr("abcdef", 1, 3) == "bcd", "substr");
check(strpos("hello", "ll") == 2, "strpos finds");
check(str_repeat("ab", 3) == "ababab", "str_repeat");
check(trim("  x  ") == "x", "trim");

// --- PHP-style typed variables ---
$n: int = 5;
$s: string = "Ann";
check($n == 5 && $s == "Ann", "typed declarations");

echo "ALL CHECKS PASSED\n";
