<?php
// Numbers, bools and null concatenated into strings print as in PHP. The
// concat helpers format numbers on the stack now (they used to leave one
// unreleased string per number behind).
$min = -9223372036854775807 - 1;
if ("a" . 0 !== "a0") { exit(1); }
if ("a" . 255 . "b" !== "a255b") { exit(2); }
if ("n=" . -42 !== "n=-42") { exit(3); }
if ("" . $min !== "-9223372036854775808") { exit(4); }
if ("" . 9223372036854775807 !== "9223372036854775807") { exit(5); }
if ("f" . 1.5 !== "f1.5") { exit(6); }
if ("f" . 2.0 !== "f2") { exit(7); }
if ("b" . true . false !== "b1") { exit(8); }
$parts = [1, -2, 3.25, true, "s"];
$s = "";
foreach ($parts as $p) { $s = $s . $p . ","; }
if ($s !== "1,-2,3.25,1,s,") { exit(9); }
$t = "x";
for ($i = 0; $i < 200000; $i++) { $t = "k" . $i; }
if ($t !== "k199999") { exit(10); }
echo 12, "-", 3.5, "\n";
println("ok");
