<?php
/* ownership_regex_loop.hphp — the regex builtins return a fresh match array
 * or string; the pattern/subject are borrowed. The loop releases every
 * result and must stay flat. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

$pat = "/[a-z]+/";
$word = "/ /";
$subj = "alpha beta gamma";
$rep = "x";
$acc = 0;
for ($i = 0; $i < 20000; $i++) {
    $n = preg_match($pat, $subj, $m);
    $acc += $n;

    $r = preg_replace($pat, $rep, $subj);
    $acc += strlen($r);

    $parts = preg_split($word, $subj);
    $acc += count($parts);
}
check("regex loop accumulated work", $acc > 0);
echo "ownership regex loop ok\n";
