<?php
/* ownership_date_check.hphp — checkdate takes numbers and returns a bool. */
$fail = 0;
function check(string $name, bool $ok): bool {
    if ($ok) { echo "OK   " . $name . "\n"; return true; }
    echo "FAIL " . $name . "\n";
    exit(1);
}

check("leap day 2024", checkdate(2, 29, 2024));
check("no leap day 2023", !checkdate(2, 29, 2023));
check("leap day 2000", checkdate(2, 29, 2000));
check("no leap day 1900", !checkdate(2, 29, 1900));
check("april has 30 days", checkdate(4, 30, 2024) && !checkdate(4, 31, 2024));
check("december has 31 days", checkdate(12, 31, 2024));
check("month 0 is invalid", !checkdate(0, 1, 2024));
check("month 13 is invalid", !checkdate(13, 1, 2024));
check("day 0 is invalid", !checkdate(1, 0, 2024));
check("year 0 is invalid", !checkdate(1, 1, 0));

$m = 2;
$d = 29;
$y = 2024;
check("arguments are borrowed", checkdate($m, $d, $y) && $m == 2 && $y == 2024);

echo "ownership date check ok\n";
