/* mathx — tiny math helpers */
function clampi(int $v, int $lo, int $hi): int {
    if ($v < $lo) { return $lo; }
    if ($v > $hi) { return $hi; }
    return $v;
}
function sqi(int $v): int { return $v * $v; }
